<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyCMS2026</RootNamespace>
    <AssemblyName>MyCMS2026</AssemblyName>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="MimeKit" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="App_Data\uploads\todos\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Laufzeitdaten: nicht in Publish-Ordner kopieren (werden beim Setup erstellt) -->
    <Content Update="App_Data\*.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="App_Data\setup-complete">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <!-- Secrets: nie publizieren -->
    <Content Update="appsettings.Production.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
