@inject MyCMS2026.Services.NavigationService NavSvc
@inject MyCMS2026.Services.SiteService SiteSvc
@functions {
    static string NavIcon(string? widget) => widget switch
    {
        "wHome"      => "bi-house-fill",
        "wAdmin"     => "bi-speedometer2",
        "wPendenzen" => "bi-list-check",
        "wHTMLPage"  => "bi-file-text",
        "wToDo"      => "bi-check2-square",
        "wMeetings"  => "bi-calendar-event",
        "wDownloads" => "bi-download",
        "wOKR"            => "bi-bullseye",
        "wMeetingTimeline" => "bi-calendar3",
        "wDashboard"       => "bi-graph-up",
        "wVault"     => "bi-safe",
        "wProjects"  => "bi-kanban",
        "wSearch"        => "bi-search",
        "wPccLink"       => "bi-box-arrow-up-right",
        "wUserSettings"  => "bi-person-gear",
        _                => "bi-circle"
    };

    static string Initials(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name[0].ToString().ToUpper();
    }
}
@{
    var site = await SiteSvc.GetAsync();
    var userRoles = User.Claims
        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
        .Select(c => c.Value)
        .ToList();
    var navTree = User.Identity?.IsAuthenticated == true
        ? await NavSvc.GetTreeAsync(userRoles)
        : new List<MyCMS2026.Models.NavItem>();

    var currentId       = Context.Request.Query["id"].ToString();
    var currentPath     = Context.Request.Path.Value?.ToLower() ?? "";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName        = User.Identity?.Name ?? "";
    var userRole        = userRoles.FirstOrDefault() ?? "";
    var menuLayout      = Context.Request.Cookies["CmsMenuLayout"] ?? "vertical";
    var menuHorizontal  = menuLayout == "horizontal";
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] – @site.Title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mycms.css" asp-append-version="true" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="MyCMS" />
    <meta name="theme-color" content="#1e2a3a" />
</head>
<body class="@(isAuthenticated && menuHorizontal ? "cms-menu-horizontal" : "")">

@if (isAuthenticated)
{
    <div class="cms-layout">

    @if (menuHorizontal)
    {
        @* ═══ TOPNAV (Horizontal-Modus) ═══ *@
        <nav class="cms-topnav navbar navbar-expand-lg" id="cmsTopnav">
            <div class="container-fluid">

                @* Brand *@
                <a class="cms-topnav-brand navbar-brand" asp-page="/Index">
                    @if (!string.IsNullOrEmpty(site.LogoUrl))
                    {
                        <img src="@Url.Content(site.LogoUrl)" alt="@site.Title" class="cms-topnav-logo" />
                    }
                    else
                    {
                        <span class="cms-topnav-brand-icon"><i class="bi bi-grid-3x3-gap-fill"></i></span>
                    }
                    <span class="ms-2">@site.Title</span>
                </a>

                @* Mobile Toggle *@
                <button class="navbar-toggler border-0 text-white" type="button"
                        data-bs-toggle="collapse" data-bs-target="#cmsTopnavMenu">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <div class="collapse navbar-collapse" id="cmsTopnavMenu">
                    <ul class="navbar-nav me-auto">
                        @foreach (var item in navTree)
                        {
                            @if (item.Children.Any())
                            {
                                var anyChildActive = item.Children.Any(c => c.Id == currentId);
                                var parentActive   = item.Id == currentId || anyChildActive ? "active" : "";
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle cms-topnav-link @parentActive"
                                       href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi @NavIcon(item.Widget) me-1"></i>@item.NavigationText
                                    </a>
                                    <ul class="dropdown-menu cms-topnav-dropdown">
                                        @if (!string.IsNullOrEmpty(item.Widget))
                                        {
                                            <li>
                                                <a class="dropdown-item @(item.Id == currentId ? "active" : "")"
                                                   asp-page="/Page/Index" asp-route-id="@item.Id">
                                                    <i class="bi @NavIcon(item.Widget) me-1"></i>@item.NavigationText
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                        }
                                        @foreach (var child in item.Children)
                                        {
                                            <li>
                                                <a class="dropdown-item @(child.Id == currentId ? "active" : "")"
                                                   asp-page="/Page/Index" asp-route-id="@child.Id">
                                                    <i class="bi @NavIcon(child.Widget) me-1"></i>@child.NavigationText
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                            else
                            {
                                var active = item.Id == currentId ? "active" : "";
                                <li class="nav-item">
                                    <a class="nav-link cms-topnav-link @active"
                                       asp-page="/Page/Index" asp-route-id="@item.Id">
                                        <i class="bi @NavIcon(item.Widget) me-1"></i>@item.NavigationText
                                    </a>
                                </li>
                            }
                        }

                        @* Admin-Links *@
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle cms-topnav-link @(currentPath.StartsWith("/admin") ? "active" : "")"
                                   href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-speedometer2 me-1"></i>Admin
                                </a>
                                <ul class="dropdown-menu cms-topnav-dropdown">
                                    <li><a class="dropdown-item" asp-page="/Admin/Users"><i class="bi bi-people-fill me-1"></i>Benutzer</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Navigation"><i class="bi bi-list-nested me-1"></i>Navigation</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Roles"><i class="bi bi-shield-lock me-1"></i>Rollen</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/SiteConfig"><i class="bi bi-sliders me-1"></i>Site-Konfiguration</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Klassen"><i class="bi bi-tags me-1"></i>Klassen</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Gruppen"><i class="bi bi-collection me-1"></i>Gruppen</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Kontext"><i class="bi bi-diagram-3 me-1"></i>Kontext</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/WeeklyMail"><i class="bi bi-envelope-paper me-1"></i>Access &amp; Report Settings</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Activity"><i class="bi bi-activity me-1"></i>Aktivitätslog</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    @* User-Bereich rechts *@
                    <ul class="navbar-nav ms-auto align-items-center gap-1">
                        <li class="nav-item">
                            <span class="nav-link cms-topnav-user text-nowrap">
                                <span class="cms-topnav-avatar me-1">@Initials(userName)</span>
                                <span class="d-none d-xl-inline">@userName</span>
                                @if (!string.IsNullOrEmpty(userRole))
                                {
                                    <span class="badge bg-secondary ms-1 d-none d-xl-inline">@userRole</span>
                                }
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link cms-topnav-link" asp-page="/Account/ChangePassword" title="Passwort ändern">
                                <i class="bi bi-key"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <form method="post" asp-page="/Account/Logout">
                                <button type="submit" class="btn btn-sm btn-outline-light ms-1">
                                    <i class="bi bi-box-arrow-right me-1"></i>Abmelden
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    }
    else
    {
        @* ═══ SIDEBAR ═══ *@
        <aside class="cms-sidebar" id="cmsSidebar">

            @* Brand *@
            <a class="cms-sidebar-brand" asp-page="/Index">
                @if (!string.IsNullOrEmpty(site.LogoUrl))
                {
                    <img src="@Url.Content(site.LogoUrl)" alt="@site.Title" />
                }
                else
                {
                    <div class="cms-sidebar-brand-icon">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                    </div>
                }
                <span class="cms-sidebar-brand-text">@site.Title</span>
            </a>

            @* Navigation *@
            <nav class="cms-sidebar-nav">

                @foreach (var item in navTree)
                {
                    @if (item.Children.Any())
                    {
                        @* Prüfen ob ein Kind aktiv ist (auto-expand) *@
                        var anyChildActive = item.Children.Any(c => c.Id == currentId);
                        var collapseId = "nav-collapse-" + item.Id;

                        @if (!string.IsNullOrEmpty(item.Widget))
                        {
                            @* Hat eigenes Widget → Link + separater Pfeil-Toggle *@
                            var parentActive = item.Id == currentId ? "active" : "";
                            <div class="cms-nav-group-header">
                                <a class="cms-nav-item flex-grow-1 @parentActive"
                                   asp-page="/Page/Index" asp-route-id="@item.Id">
                                    <i class="bi @NavIcon(item.Widget) cms-nav-icon"></i>
                                    @item.NavigationText
                                </a>
                                <button class="cms-nav-toggle" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                        data-collapse-id="@collapseId"
                                        aria-expanded="@(anyChildActive ? "true" : "false")">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            @* Nur Gruppenheader → ganzer Header ist Toggle *@
                            <button class="cms-nav-group-btn" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                    data-collapse-id="@collapseId"
                                    aria-expanded="@(anyChildActive ? "true" : "false")">
                                <span>@item.NavigationText</span>
                                <i class="bi bi-chevron-down cms-nav-toggle-icon"></i>
                            </button>
                        }

                        <div class="collapse cms-nav-children @(anyChildActive ? "show" : "")" id="@collapseId">
                            @foreach (var child in item.Children)
                            {
                                var childActive = child.Id == currentId ? "active" : "";
                                <a class="cms-nav-item @childActive"
                                   asp-page="/Page/Index" asp-route-id="@child.Id">
                                    <i class="bi @NavIcon(child.Widget) cms-nav-icon"></i>
                                    @child.NavigationText
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        var active = item.Id == currentId ? "active" : "";
                        <a class="cms-nav-item @active"
                           asp-page="/Page/Index" asp-route-id="@item.Id">
                            <i class="bi @NavIcon(item.Widget) cms-nav-icon"></i>
                            @item.NavigationText
                        </a>
                    }
                }

                @* Admin-Bereich *@
                @if (User.IsInRole("Administrator"))
                {
                    <div class="cms-nav-divider"></div>
                    <div class="cms-nav-label">Administration</div>
                    <a class="cms-nav-item @(currentPath.StartsWith("/admin/users") ? "active" : "")"
                       asp-page="/Admin/Users">
                        <i class="bi bi-people-fill cms-nav-icon"></i>
                        Benutzer
                    </a>
                    <a class="cms-nav-item @(currentPath.StartsWith("/admin/navigation") ? "active" : "")"
                       asp-page="/Admin/Navigation">
                        <i class="bi bi-list-nested cms-nav-icon"></i>
                        Navigation
                    </a>
                    <a class="cms-nav-item @(currentPath.StartsWith("/admin/roles") ? "active" : "")"
                       asp-page="/Admin/Roles">
                        <i class="bi bi-shield-lock cms-nav-icon"></i>
                        Rollen
                    </a>
                    <a class="cms-nav-item @(currentPath.StartsWith("/admin/siteconfig") ? "active" : "")"
                       asp-page="/Admin/SiteConfig">
                        <i class="bi bi-sliders cms-nav-icon"></i>
                        Site-Konfiguration
                    </a>
                    <a class="cms-nav-item @(currentPath.StartsWith("/admin/klassen") ? "active" : "")"
                       asp-page="/Admin/Klassen">
                        <i class="bi bi-tags cms-nav-icon"></i>
                        Klassen
                    </a>
                    <a class="cms-nav-item @(currentPath.StartsWith("/admin/gruppen") ? "active" : "")"
                       asp-page="/Admin/Gruppen">
                        <i class="bi bi-collection cms-nav-icon"></i>
                        Gruppen
                    </a>
                    <a class="cms-nav-item @(currentPath.StartsWith("/admin/kontext") ? "active" : "")"
                       asp-page="/Admin/Kontext">
                        <i class="bi bi-diagram-3 cms-nav-icon"></i>
                        Kontext
                    </a>
                    <a class="cms-nav-item @(currentPath.StartsWith("/admin/weeklymail") ? "active" : "")"
                       asp-page="/Admin/WeeklyMail">
                        <i class="bi bi-envelope-paper cms-nav-icon"></i>
                        Access &amp; Report Settings
                    </a>
                    <a class="cms-nav-item @(currentPath.StartsWith("/admin/activity") ? "active" : "")"
                       asp-page="/Admin/Activity">
                        <i class="bi bi-activity cms-nav-icon"></i>
                        Aktivitätslog
                    </a>
                }

            </nav>

            @* User / Footer *@
            <div class="cms-sidebar-footer">
                <div class="cms-user-info">
                    <div class="cms-user-avatar">@Initials(userName)</div>
                    <div>
                        <div class="cms-user-name">@userName</div>
                        <div class="cms-user-role">@userRole</div>
                    </div>
                </div>
                <div class="cms-footer-actions">
                    <a class="cms-footer-btn" asp-page="/Account/ChangePassword" title="Passwort ändern">
                        <i class="bi bi-key"></i>
                        <span>Passwort</span>
                    </a>
                    <form method="post" asp-page="/Account/Logout" style="flex:1;display:contents;">
                        <button type="submit" class="cms-footer-btn danger">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Abmelden</span>
                        </button>
                    </form>
                </div>
            </div>

        </aside>
    }@* /else sidebar *@

        @* ═══ MAIN ═══ *@
        <div class="cms-main">

            @* Mobile Topbar (nur Sidebar-Modus) *@
            @if (!menuHorizontal)
            {
            <header class="cms-topbar">
                <button class="cms-topbar-toggle" id="sidebarToggle" aria-label="Menü">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <span class="cms-topbar-title">@ViewData["Title"]</span>
            </header>
            }

            @* Page Content *@
            <main class="cms-content">
                @RenderBody()
            </main>

        </div>@* /cms-main *@

        @* ═══ GLOBALER LÖSCH-BESTÄTIGUNGSDIALOG ═══ *@
        <div class="modal fade" id="cmsDeleteModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-danger text-white border-0">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <h5 class="modal-title mb-0">Löschen bestätigen</h5>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body py-4 px-4" id="cmsDeleteModalMsg">
                        Soll dieser Eintrag wirklich gelöscht werden?
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-lg me-1"></i>Abbrechen
                        </button>
                        <button type="button" class="btn btn-danger" id="cmsDeleteModalConfirm">
                            <i class="bi bi-trash me-1"></i>Löschen
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>@* /cms-layout *@
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    // Mobile sidebar toggle
    document.getElementById('sidebarToggle')?.addEventListener('click', function () {
        document.getElementById('cmsSidebar')?.classList.toggle('open');
    });

    // ─── Globaler Lösch-Dialog ────────────────────────────────────────────────
    (function () {
        var _pendingForm = null;
        var _modal = null;

        window.cmsConfirmDelete = function (formOrId, message) {
            _pendingForm = typeof formOrId === 'string'
                ? document.getElementById(formOrId)
                : formOrId;
            document.getElementById('cmsDeleteModalMsg').textContent =
                message || 'Soll dieser Eintrag wirklich gelöscht werden?';
            if (!_modal) _modal = new bootstrap.Modal(document.getElementById('cmsDeleteModal'));
            _modal.show();
            return false;
        };

        document.getElementById('cmsDeleteModalConfirm')?.addEventListener('click', function () {
            if (_pendingForm) {
                _modal.hide();
                _pendingForm.submit();
                _pendingForm = null;
            }
        });
    })();

    // Collapsible nav: Pfeil-Rotation + localStorage
    (function () {
        var STORE_KEY = 'cmsNavCollapse';
        var stored = {};
        try { stored = JSON.parse(localStorage.getItem(STORE_KEY) || '{}'); } catch(e) {}

        document.querySelectorAll('[data-collapse-id]').forEach(function (btn) {
            var id = btn.dataset.collapseId;
            var target = document.getElementById(id);
            if (!target) return;

            // Zustand aus localStorage – aber nicht wenn ein Kind aktiv ist
            var hasActiveChild = target.querySelector('.cms-nav-item.active');
            if (!hasActiveChild && id in stored) {
                if (stored[id] === 'open')  { target.classList.add('show');    btn.setAttribute('aria-expanded','true');  }
                if (stored[id] === 'closed') { target.classList.remove('show'); btn.setAttribute('aria-expanded','false'); }
            }

            // Zustand speichern wenn Bootstrap Collapse sich ändert
            target.addEventListener('show.bs.collapse',  function() { stored[id] = 'open';   localStorage.setItem(STORE_KEY, JSON.stringify(stored)); });
            target.addEventListener('hide.bs.collapse',  function() { stored[id] = 'closed'; localStorage.setItem(STORE_KEY, JSON.stringify(stored)); });
        });
    })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
