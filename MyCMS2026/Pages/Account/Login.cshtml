@page
@model MyCMS2026.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Anmelden";
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anmelden – @Model.SiteTitle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mycms.css" asp-append-version="true" />
    <meta name="robots" content="noindex, nofollow" />
</head>
<body class="login-body">
<div class="login-wrapper">
    <div class="login-brand-icon">
        @if (!string.IsNullOrEmpty(Model.SiteLogoUrl))
        {
            <img src="@Url.Content(Model.SiteLogoUrl)" alt="@Model.SiteTitle"
                 style="max-height:72px;max-width:180px;object-fit:contain;" />
        }
        else
        {
            <i class="bi bi-grid-3x3-gap-fill"></i>
        }
    </div>
    <div class="card login-card">
        <div class="card-body p-4">
            <h5 class="text-center fw-bold mb-1">@Model.SiteTitle</h5>
            <p class="text-center text-muted small mb-4">Bitte melden Sie sich an</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 small">
                    <i class="bi bi-exclamation-circle me-1"></i>@Model.ErrorMessage
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Benutzername</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-person text-muted"></i>
                        </span>
                        <input asp-for="UserName" class="form-control border-start-0 ps-0"
                               autofocus autocomplete="username" placeholder="Benutzername" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Passwort</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-lock text-muted"></i>
                        </span>
                        <input asp-for="Password" type="password"
                               class="form-control border-start-0 ps-0"
                               autocomplete="current-password" placeholder="Passwort" />
                    </div>
                </div>
                <div class="mb-4 form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                    <label asp-for="RememberMe" class="form-check-label small">Angemeldet bleiben</label>
                </div>
                <button type="submit" class="btn btn-cms w-100 py-2">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Anmelden
                </button>
            </form>
            <div class="text-center mt-3">
                <a asp-page="/Account/ForgotPassword" class="small text-muted">
                    Passwort vergessen?
                </a>
            </div>
        </div>
    </div>
    <p class="text-center mt-3 small" style="color:rgba(255,255,255,.5);">
        MyCMS 2026
    </p>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
