@page
@model MyCMS2026.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Neues Passwort setzen";
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Neues Passwort – @Model.SiteTitle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mycms.css" asp-append-version="true" />
    <meta name="robots" content="noindex, nofollow" />
</head>
<body class="login-body">
<div class="login-wrapper">
    <div class="login-brand-icon">
        <i class="bi bi-grid-3x3-gap-fill"></i>
    </div>
    <div class="card login-card">
        <div class="card-body p-4">
            <h5 class="text-center fw-bold mb-1">@Model.SiteTitle</h5>
            <p class="text-center text-muted small mb-4">Neues Passwort festlegen</p>

            @if (Model.Success)
            {
                <div class="alert alert-success py-2 small">
                    <i class="bi bi-check-circle me-1"></i>Passwort erfolgreich geändert.
                </div>
                <a href="/Account/Login" class="btn btn-cms w-100 mt-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Jetzt anmelden
                </a>
            }
            else if (!Model.TokenValid)
            {
                <div class="alert alert-danger py-2 small">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    Dieser Reset-Link ist ungültig oder abgelaufen.
                </div>
                <a href="/Account/ForgotPassword" class="btn btn-outline-secondary w-100 mt-2">
                    Neuen Link anfordern
                </a>
            }
            else
            {
                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger py-2 small">
                        <i class="bi bi-exclamation-circle me-1"></i>@Model.Error
                    </div>
                }
                <form method="post">
                    <input type="hidden" asp-for="Token" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Neues Passwort</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-lock text-muted"></i>
                            </span>
                            <input asp-for="NewPassword" type="password"
                                   class="form-control border-start-0 ps-0"
                                   autofocus autocomplete="new-password"
                                   placeholder="Mindestens 8 Zeichen" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold small">Passwort bestätigen</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-lock-fill text-muted"></i>
                            </span>
                            <input asp-for="ConfirmPassword" type="password"
                                   class="form-control border-start-0 ps-0"
                                   autocomplete="new-password"
                                   placeholder="Passwort wiederholen" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-cms w-100 py-2">
                        <i class="bi bi-check-lg me-2"></i>Passwort speichern
                    </button>
                </form>
            }
        </div>
    </div>
    <p class="text-center mt-3 small" style="color:rgba(255,255,255,.5);">MyCMS 2026</p>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
