@page
@model MyCMS2026.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Passwort vergessen";
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Passwort vergessen – @Model.SiteTitle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mycms.css" asp-append-version="true" />
    <meta name="robots" content="noindex, nofollow" />
</head>
<body class="login-body">
<div class="login-wrapper">
    <div class="login-brand-icon">
        <i class="bi bi-grid-3x3-gap-fill"></i>
    </div>
    <div class="card login-card">
        <div class="card-body p-4">
            <h5 class="text-center fw-bold mb-1">@Model.SiteTitle</h5>
            <p class="text-center text-muted small mb-4">Passwort zurücksetzen</p>

            @if (Model.Sent)
            {
                <div class="alert alert-success py-2 small">
                    <i class="bi bi-envelope-check me-1"></i>@Model.Message
                </div>
                <a asp-page="/Account/Login" class="btn btn-outline-secondary w-100 mt-2">
                    <i class="bi bi-arrow-left me-1"></i>Zurück zur Anmeldung
                </a>
            }
            else
            {
                <p class="small text-muted mb-3">
                    Geben Sie Ihren Benutzernamen oder Ihre E-Mail-Adresse ein.
                    Sie erhalten einen Link zum Zurücksetzen Ihres Passworts.
                </p>
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Benutzername oder E-Mail</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-person text-muted"></i>
                            </span>
                            <input asp-for="UserNameOrEmail" class="form-control border-start-0 ps-0"
                                   autofocus autocomplete="email" placeholder="Benutzername oder E-Mail" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-cms w-100 py-2">
                        <i class="bi bi-envelope me-2"></i>Reset-Link senden
                    </button>
                </form>
                <div class="text-center mt-3">
                    <a asp-page="/Account/Login" class="small text-muted">
                        <i class="bi bi-arrow-left me-1"></i>Zurück zur Anmeldung
                    </a>
                </div>
            }
        </div>
    </div>
    <p class="text-center mt-3 small" style="color:rgba(255,255,255,.5);">MyCMS 2026</p>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
