@page "{id}"
@model MyCMS2026.Pages.Projects.ProjectDetailModel
@using System.IO
@inject MyCMS2026.Services.TodoService TodoSvcView
@inject MyCMS2026.Services.MeetingService MeetingSvcView
@inject Ganss.Xss.HtmlSanitizer Sanitizer
@{
    ViewData["Title"] = Model.Project.Name;
    var p   = Model.Project;
    var tab = Model.ActiveTab ?? "journal";

    // Rotierende Akzentfarben für Journaleinträge
    var jAccents = new[] {
        ("#4361ee", "rgba(67,97,238,.07)"),    // Indigo
        ("#0d9488", "rgba(13,148,136,.07)"),   // Teal
        ("#7c3aed", "rgba(124,58,237,.07)"),   // Violett
        ("#d97706", "rgba(217,119,6,.07)"),    // Amber
        ("#0284c7", "rgba(2,132,199,.07)"),    // Sky
    };
    int jIdx = 0;
}

<div>
    <div class="cms-page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1 class="cms-page-title mb-0">
                <i class="bi bi-kanban me-2"></i>@p.Name
            </h1>
        </div>
        <div class="d-flex gap-2">
            <a href="~/" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Start
            </a>
            @if (Model.CanEdit)
            {
                <a asp-page="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-pencil me-1"></i>Bearbeiten
                </a>
            }
        </div>
    </div>

    <div class="cms-page-body pt-3">

        @* Metadaten-Panel *@
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-3">
                <div class="row g-2 small">
                    <div class="col-6 col-md-3">
                        <div class="text-muted mb-1"><i class="bi bi-circle-fill me-1" style="font-size:.5rem;vertical-align:middle;"></i>Status</div>
                        <span class="badge @(p.Status == "Aktiv" ? "bg-success" : p.Status == "Pausiert" ? "bg-warning text-dark" : "bg-secondary")">@p.Status</span>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted mb-1"><i class="bi bi-person me-1"></i>Projektleiter</div>
                        <div class="fw-semibold">@(string.IsNullOrEmpty(p.Projektleiter) ? "–" : p.Projektleiter)</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted mb-1"><i class="bi bi-calendar me-1"></i>Start</div>
                        <div class="fw-semibold">@(p.StartDatum?.ToString("dd.MM.yyyy") ?? "–")</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-muted mb-1"><i class="bi bi-calendar-check me-1"></i>Ende</div>
                        <div class="fw-semibold">@(p.EndDatum?.ToString("dd.MM.yyyy") ?? "–")</div>
                    </div>
                    @if (!string.IsNullOrEmpty(p.Gruppe))
                    {
                        <div class="col-6 col-md-3">
                            <div class="text-muted mb-1"><i class="bi bi-people me-1"></i>Gruppe</div>
                            <span class="badge bg-primary">@p.Gruppe</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(p.Beschreibung))
                    {
                        <div class="col-12 mt-1">
                            <div class="text-muted mb-1"><i class="bi bi-text-left me-1"></i>Beschreibung</div>
                            <div>@p.Beschreibung</div>
                        </div>
                    }
                    @if (Model.IsAdmin)
                    {
                        <div class="col-6 col-md-3 mt-1">
                            <div class="text-muted mb-1"><i class="bi bi-eye me-1"></i>Lesen</div>
                            <span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(p.LeseRolle) ? "alle" : p.LeseRolle)</span>
                        </div>
                        <div class="col-6 col-md-3 mt-1">
                            <div class="text-muted mb-1"><i class="bi bi-pencil me-1"></i>Bearbeiten</div>
                            <span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(p.BearbeitenRolle) ? "nur Admin" : p.BearbeitenRolle)</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Tabs *@
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a class="nav-link @(tab == "journal" ? "active" : "")"
                   asp-page="Detail" asp-route-id="@p.Id" asp-route-tab="journal">
                    <i class="bi bi-journal-text me-1"></i>Journal
                    @if (p.Journal.Any())
                    {
                        <span class="badge bg-secondary ms-1">@p.Journal.Count</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tab == "todos" ? "active" : "")"
                   asp-page="Detail" asp-route-id="@p.Id" asp-route-tab="todos">
                    <i class="bi bi-check2-square me-1"></i>Aufgaben
                    @if (Model.Todos.Any())
                    {
                        <span class="badge bg-secondary ms-1">@Model.Todos.Count</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tab == "meetings" ? "active" : "")"
                   asp-page="Detail" asp-route-id="@p.Id" asp-route-tab="meetings">
                    <i class="bi bi-calendar-event me-1"></i>Sitzungen
                    @if (Model.Meetings.Any())
                    {
                        <span class="badge bg-secondary ms-1">@Model.Meetings.Count</span>
                    }
                </a>
            </li>
        </ul>

        @* ─── JOURNAL TAB ───────────────────────────────────────────────── *@
        @if (tab == "journal")
        {
            @if (Model.CanEdit)
            {
                <div class="d-flex justify-content-end mb-3">
                    <button type="button" class="btn btn-cms btn-sm"
                            data-bs-toggle="collapse" data-bs-target="#newJournalPanel">
                        <i class="bi bi-plus-circle me-1"></i>Neuer Journaleintrag
                    </button>
                </div>
                <div class="collapse mb-4" id="newJournalPanel">
                    <div class="card">
                        <div class="card-header card-header-cms">
                            <i class="bi bi-journal-plus me-1"></i>Neuer Journaleintrag
                        </div>
                        <div class="card-body">
                            <form method="post" asp-page-handler="AddJournal">
                                <input type="hidden" name="id" value="@p.Id" />
                                <div class="row g-2 mb-2">
                                    <div class="col-md-9">
                                        <input type="text" name="titel" class="form-control" placeholder="Titel..." required />
                                    </div>
                                    <div class="col-md-3">
                                        <input type="datetime-local" name="createdAt" class="form-control"
                                               value="@DateTime.Today.ToString("yyyy-MM-dd")T12:00" />
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <textarea id="newJournalContent" name="content" class="form-control" rows="5"></textarea>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-cms btn-sm">
                                        <i class="bi bi-check-lg me-1"></i>Speichern
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            data-bs-toggle="collapse" data-bs-target="#newJournalPanel">
                                        Abbrechen
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @if (!p.Journal.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-journal fs-1 d-block mb-2"></i>
                    Noch keine Journaleinträge vorhanden.
                </div>
            }
            else
            {
                @foreach (var entry in p.Journal.OrderByDescending(e => e.CreatedAt))
                {
                    var (accent, bgTint) = jAccents[jIdx % jAccents.Length];
                    jIdx++;

                    <div class="card mb-3 border-0 shadow-sm" id="entry-@entry.Id"
                         style="border-left: 4px solid @accent !important;">

                        @* Header – klickbar zum Auf-/Zuklappen *@
                        <div class="card-header d-flex justify-content-between align-items-start gap-2 py-2 px-3 journal-header"
                             style="background: @bgTint; border-bottom: 1px solid rgba(0,0,0,.06); cursor: pointer;"
                             data-journal-target="#jBody-@entry.Id" aria-expanded="false">
                            <div class="flex-fill min-w-0">
                                <div class="fw-bold" style="color: @accent;">
                                    @entry.Titel
                                    @if (entry.Files.Any())
                                    {
                                        <span class="badge bg-light text-secondary border ms-1 fw-normal"
                                              style="font-size:.7rem;" title="@entry.Files.Count Datei(en)">
                                            <i class="bi bi-paperclip"></i> @entry.Files.Count
                                        </span>
                                    }
                                </div>
                                @* Link-Badge für verknüpfte Aufgabe / Sitzung – Wrapper stoppt Collapse-Trigger *@
                                @if (!string.IsNullOrEmpty(entry.LinkedTodoId) || !string.IsNullOrEmpty(entry.LinkedMeetingId))
                                {
                                    <div class="d-inline-block mt-1">
                                    @if (!string.IsNullOrEmpty(entry.LinkedTodoId))
                                    {
                                        var lt = Model.Todos.FirstOrDefault(t => t.Id == entry.LinkedTodoId);
                                        <a asp-page="/Todos/Detail" asp-route-id="@entry.LinkedTodoId"
                                           asp-route-returnProjectId="@p.Id"
                                           class="badge text-decoration-none me-1"
                                           style="background:@accent; font-weight:normal;"
                                           title="Verknüpfte Aufgabe öffnen">
                                            <i class="bi bi-check2-square me-1"></i>Aufgabe @(lt?.TaskNr.ToString() ?? "")
                                        </a>
                                        @if (lt != null)
                                        {
                                            <span class="badge @(lt.Erledigt ? "bg-success" : ((lt.ErledigenBis - DateTime.Today).Days < 0 ? "bg-danger" : "bg-warning text-dark")) me-1">
                                                @(lt.Erledigt ? "Erledigt" : "Offen")
                                            </span>
                                            @if (!string.IsNullOrEmpty(lt.Verantwortlich))
                                            {
                                                <span class="small text-muted me-2"><i class="bi bi-person me-1"></i>@lt.Verantwortlich</span>
                                            }
                                            <span class="small text-muted"><i class="bi bi-calendar3 me-1"></i>bis @lt.ErledigenBis.ToString("dd.MM.yyyy")</span>
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(entry.LinkedMeetingId))
                                    {
                                        var lm = Model.Meetings.FirstOrDefault(m => m.Id == entry.LinkedMeetingId);
                                        <a asp-page="/Meetings/Detail" asp-route-id="@entry.LinkedMeetingId"
                                           asp-route-returnProjectId="@p.Id"
                                           class="badge text-decoration-none me-1"
                                           style="background:@accent; font-weight:normal;"
                                           title="Verknüpfte Sitzung öffnen">
                                            <i class="bi bi-calendar-event me-1"></i>Sitzung @(lm?.MeetingNr.ToString() ?? "")
                                        </a>
                                        @if (lm != null)
                                        {
                                            var mStatusClass = lm.Status == "Abgeschlossen" ? "bg-success" : (lm.Status == "Abgesagt" ? "bg-secondary" : "bg-info text-dark");
                                            <span class="badge @mStatusClass me-1">@lm.Status</span>
                                            @if (!string.IsNullOrEmpty(lm.Leitung))
                                            {
                                                <span class="small text-muted me-2"><i class="bi bi-person me-1"></i>@lm.Leitung</span>
                                            }
                                            <span class="small text-muted"><i class="bi bi-calendar3 me-1"></i>@lm.Datum.ToString("dd.MM.yyyy")</span>
                                        }
                                    }
                                    </div>
                                }
                                <div class="small text-muted mt-1">
                                    <i class="bi bi-person me-1"></i>@entry.CreatedBy
                                    @if (entry.UpdatedAt > entry.CreatedAt.AddMinutes(1))
                                    {
                                        <span class="ms-3 fst-italic">bearbeitet @entry.UpdatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                <div class="text-end">
                                    <div class="fw-semibold small" style="color:@accent;">
                                        @entry.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                    </div>
                                    <div class="text-muted" style="font-size:.75rem;">
                                        @entry.CreatedAt.ToLocalTime().ToString("HH:mm")
                                    </div>
                                </div>
                                @if (Model.CanEdit)
                                {
                                    <div class="d-flex gap-1" onclick="event.stopPropagation()">
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                onclick="projToggleEdit('@entry.Id')" title="Bearbeiten">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form id="delJournal-@entry.Id" method="post" asp-page-handler="DeleteJournal" style="display:none">
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="hidden" name="entryId" value="@entry.Id" />
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                onclick="cmsConfirmDelete('delJournal-@entry.Id', 'Journaleintrag «@entry.Titel.Replace("'", "\\'")» löschen?')"
                                                title="Löschen">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                                <i class="bi bi-chevron-down journal-chevron ms-1" style="color: @accent; transition: transform .2s;"></i>
                            </div>
                        </div>

                        @* Kollabierbare Inhalte *@
                        <div id="jBody-@entry.Id" class="collapse">

                        @* View mode *@
                        <div id="view-@entry.Id" class="card-body px-3 py-3">
                            @* Sanitize: Member-Inhalte können Skripte enthalten (Stored XSS) *@
                            <div class="journal-content">@Html.Raw(Sanitizer.Sanitize(entry.Content))</div>

                            @* Dateien *@
                            @if (entry.Files.Any() || Model.CanEdit)
                            {
                                <div class="mt-3 pt-2 border-top">
                                    @foreach (var jf in entry.Files)
                                    {
                                        var jExt = System.IO.Path.GetExtension(jf.OriginalName).ToLowerInvariant();
                                        var jIcon = jExt switch {
                                            ".pdf"               => "bi-file-pdf text-danger",
                                            ".docx" or ".doc"    => "bi-file-word text-primary",
                                            ".xlsx" or ".xls"    => "bi-file-excel text-success",
                                            ".pptx" or ".ppt"    => "bi-file-ppt text-warning",
                                            ".jpg" or ".jpeg"
                                                or ".png" or ".gif" => "bi-file-image text-info",
                                            _                    => "bi-file-earmark"
                                        };
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <i class="bi @jIcon fs-6 flex-shrink-0"></i>
                                            <a asp-page="JournalFile"
                                               asp-route-projectId="@p.Id"
                                               asp-route-entryId="@entry.Id"
                                               asp-route-fileId="@jf.Id"
                                               asp-route-fileName="@jf.OriginalName"
                                               class="text-decoration-none flex-grow-1 small">@jf.OriginalName</a>
                                            <span class="text-muted flex-shrink-0" style="font-size:.75rem">@(jf.Size / 1024) KB</span>
                                            @if (Model.CanEdit)
                                            {
                                                <form method="post" asp-page-handler="DeleteJournalFile"
                                                      class="d-inline flex-shrink-0">
                                                    <input type="hidden" name="id" value="@p.Id" />
                                                    <input type="hidden" name="entryId" value="@entry.Id" />
                                                    <input type="hidden" name="fileId" value="@jf.Id" />
                                                    <button type="button" class="btn btn-sm btn-link text-danger p-0"
                                                            onclick="cmsConfirmDelete(this.closest('form'), 'Datei «@jf.OriginalName.Replace("'", "\\'")» löschen?')"
                                                            title="Löschen">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    }
                                    @if (Model.CanEdit)
                                    {
                                        <form method="post" asp-page-handler="UploadJournalFile"
                                              enctype="multipart/form-data"
                                              class="d-flex gap-2 mt-2" onclick="event.stopPropagation()">
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="hidden" name="entryId" value="@entry.Id" />
                                            <input type="file" name="file" class="form-control form-control-sm" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm flex-shrink-0">
                                                <i class="bi bi-upload me-1"></i>Hochladen
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>

                        @* Edit mode *@
                        @if (Model.CanEdit)
                        {
                            <div id="edit-@entry.Id" class="card-body border-top px-3 py-3 d-none">
                                <form method="post" asp-page-handler="UpdateJournal">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <input type="hidden" name="entryId" value="@entry.Id" />
                                    <div class="row g-2 mb-2">
                                        <div class="col-md-9">
                                            <input type="text" name="titel" value="@entry.Titel" class="form-control" required />
                                        </div>
                                        <div class="col-md-3">
                                            <input type="datetime-local" name="createdAt" class="form-control"
                                                   value="@entry.CreatedAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
                                        </div>
                                    </div>
                                    <div class="mb-2">
                                        <textarea id="editContent-@entry.Id" name="content" class="form-control" rows="5">@entry.Content</textarea>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="submit" class="btn btn-cms btn-sm">
                                            <i class="bi bi-check-lg me-1"></i>Speichern
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                onclick="projToggleEdit('@entry.Id')">
                                            Abbrechen
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }

                        @* Comments *@
                        @if (entry.Comments.Any() || Model.CanComment)
                        {
                        <div class="card-footer py-2 px-3" style="background:rgba(0,0,0,.02);">
                            @foreach (var comment in entry.Comments)
                            {
                                <div class="d-flex justify-content-between align-items-start mb-2 pb-2 border-bottom">
                                    <div>
                                        <div class="small">@comment.Text</div>
                                        <div class="text-muted" style="font-size:.75rem">
                                            <i class="bi bi-person me-1"></i>@comment.CreatedBy
                                            <span class="ms-1">@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                        </div>
                                    </div>
                                    @if (Model.CanEdit)
                                    {
                                        <form method="post" asp-page-handler="DeleteComment">
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="hidden" name="entryId" value="@entry.Id" />
                                            <input type="hidden" name="commentId" value="@comment.Id" />
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2"
                                                    onclick="cmsConfirmDelete(this.closest('form'), 'Kommentar löschen?')">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                            @if (Model.CanComment)
                            {
                                <form method="post" asp-page-handler="AddComment" class="d-flex gap-2 mt-1">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <input type="hidden" name="entryId" value="@entry.Id" />
                                    <input type="text" name="text" class="form-control form-control-sm"
                                           placeholder="Kommentar hinzufügen..." required />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm flex-shrink-0">
                                        <i class="bi bi-send"></i>
                                    </button>
                                </form>
                            }
                        </div>
                        }@* /if comments || canComment *@

                        </div>@* /collapse jBody *@
                    </div>
                }
            }
        }

        @* ─── AUFGABEN TAB ──────────────────────────────────────────────── *@
        @if (tab == "todos")
        {
            <div class="d-flex justify-content-end mb-3 gap-2">
                @if (Model.CanEdit)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            data-bs-toggle="collapse" data-bs-target="#assignTodoPanel">
                        <i class="bi bi-link me-1"></i>Bestehende Aufgabe zuordnen
                    </button>
                    <a asp-page="/Todos/Edit" asp-route-projectId="@p.Id" class="btn btn-cms btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>Neue Aufgabe
                    </a>
                }
            </div>

            @if (Model.CanEdit)
            {
                <div class="collapse mb-3" id="assignTodoPanel">
                    @{
                        var allTodos = await TodoSvcView.GetAllAsync();
                        var unassigned = allTodos.Where(t => string.IsNullOrEmpty(t.ProjectId)).ToList();
                    }
                    @if (unassigned.Any())
                    {
                        <div class="card">
                            <div class="card-body py-2">
                                <form method="post" asp-page-handler="AssignTodo" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <select name="todoId" class="form-select form-select-sm flex-fill">
                                        @foreach (var t in unassigned.OrderBy(t => t.Thema))
                                        {
                                            <option value="@t.Id">#@t.TaskNr – @t.Thema @(t.Erledigt ? "✓" : "")</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-outline-primary btn-sm flex-shrink-0">
                                        <i class="bi bi-link me-1"></i>Zuordnen
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info py-2 small">Keine nicht zugeordneten Aufgaben vorhanden.</div>
                    }
                </div>
            }

            @if (!Model.Todos.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-check2-square fs-1 d-block mb-2"></i>
                    Noch keine Aufgaben diesem Projekt zugeordnet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Thema</th>
                                <th>Verantwortlich</th>
                                <th>Bis</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Todos)
                            {
                                <tr class="@(t.Erledigt ? "text-muted" : "")">
                                    <td>@t.TaskNr</td>
                                    <td>@t.Thema</td>
                                    <td>@t.Verantwortlich</td>
                                    <td>@t.ErledigenBis.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        @if (t.Erledigt)
                                        {
                                            <span class="badge bg-success">Erledigt</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Offen</span>
                                        }
                                    </td>
                                    <td class="text-nowrap">
                                        <a asp-page="/Todos/Detail" asp-route-id="@t.Id" asp-route-returnProjectId="@p.Id"
                                           class="btn btn-sm btn-outline-primary" title="Öffnen">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (Model.CanEdit)
                                        {
                                            <a asp-page="/Todos/Edit" asp-route-id="@t.Id"
                                               class="btn btn-sm btn-outline-secondary" title="Bearbeiten">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" asp-page-handler="ToggleTodo" class="d-inline">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <input type="hidden" name="todoId" value="@t.Id" />
                                                <button type="submit" class="btn btn-sm @(t.Erledigt ? "btn-success" : "btn-outline-success")"
                                                        title="@(t.Erledigt ? "Als offen markieren" : "Als erledigt markieren")">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="RemoveTodo" class="d-inline">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <input type="hidden" name="todoId" value="@t.Id" />
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        title="Aus Projekt entfernen"
                                                        onclick="cmsConfirmDelete(this.closest('form'), 'Aufgabe «@t.Thema.Replace("'", "\\'")» aus Projekt entfernen (nicht löschen)?')">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

        @* ─── SITZUNGEN TAB ─────────────────────────────────────────────── *@
        @if (tab == "meetings")
        {
            <div class="d-flex justify-content-end mb-3 gap-2">
                @if (Model.CanEdit)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            data-bs-toggle="collapse" data-bs-target="#assignMeetingPanel">
                        <i class="bi bi-link me-1"></i>Bestehende Sitzung zuordnen
                    </button>
                    <a asp-page="/Meetings/Edit" asp-route-projectId="@p.Id" class="btn btn-cms btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>Neue Sitzung
                    </a>
                }
            </div>

            @if (Model.CanEdit)
            {
                <div class="collapse mb-3" id="assignMeetingPanel">
                    @{
                        var allMeetings = await MeetingSvcView.GetAllAsync();
                        var unassignedM = allMeetings.Where(m => string.IsNullOrEmpty(m.ProjectId)).ToList();
                    }
                    @if (unassignedM.Any())
                    {
                        <div class="card">
                            <div class="card-body py-2">
                                <form method="post" asp-page-handler="AssignMeeting" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <select name="meetingId" class="form-select form-select-sm flex-fill">
                                        @foreach (var m in unassignedM.OrderByDescending(m => m.Datum))
                                        {
                                            <option value="@m.Id">#@m.MeetingNr – @m.Datum.ToString("dd.MM.yyyy") @m.Thema</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-outline-primary btn-sm flex-shrink-0">
                                        <i class="bi bi-link me-1"></i>Zuordnen
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info py-2 small">Keine nicht zugeordneten Sitzungen vorhanden.</div>
                    }
                </div>
            }

            @if (!Model.Meetings.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-calendar-event fs-1 d-block mb-2"></i>
                    Noch keine Sitzungen diesem Projekt zugeordnet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Datum</th>
                                <th>Thema</th>
                                <th>Leitung</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Meetings.OrderByDescending(m => m.Datum))
                            {
                                <tr>
                                    <td>@m.MeetingNr</td>
                                    <td>@m.Datum.ToString("dd.MM.yyyy")</td>
                                    <td>@m.Thema</td>
                                    <td>@m.Leitung</td>
                                    <td>
                                        <span class="badge @(m.Status == "Abgeschlossen" ? "bg-success" : m.Status == "Abgesagt" ? "bg-danger" : "bg-secondary")">
                                            @m.Status
                                        </span>
                                    </td>
                                    <td class="text-nowrap">
                                        <a asp-page="/Meetings/Detail" asp-route-id="@m.Id" asp-route-returnProjectId="@p.Id"
                                           class="btn btn-sm btn-outline-primary" title="Öffnen">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (Model.CanEdit)
                                        {
                                            <a asp-page="/Meetings/Edit" asp-route-id="@m.Id"
                                               class="btn btn-sm btn-outline-secondary" title="Bearbeiten">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" asp-page-handler="RemoveMeeting" class="d-inline">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <input type="hidden" name="meetingId" value="@m.Id" />
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        title="Aus Projekt entfernen"
                                                        onclick="cmsConfirmDelete(this.closest('form'), 'Sitzung «@m.Thema.Replace("'", "\\'")» aus Projekt entfernen (nicht löschen)?')">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

    </div>@* /cms-page-body *@
</div>

@* ── Journal-Prompt Modal ────────────────────────────────────────────── *@
@if (!string.IsNullOrEmpty(Model.PromptJournalId) && Model.CanEdit)
{
<div class="modal fade" id="modalJournalPrompt" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-journal-plus me-2"></i>Journaleintrag erstellen?</h5>
            </div>
            <div class="modal-body">
                <p>Möchten Sie für <strong>@Model.PromptJournalTitle</strong> einen Journaleintrag anlegen?</p>
                <p class="text-muted small">Der Eintrag wird direkt im Bearbeiten-Modus geöffnet, damit Sie ergänzende Notizen hinzufügen können.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Nein, danke</button>
                <form method="post" asp-page-handler="AddLinkedJournal" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Project.Id" />
                    <input type="hidden" name="linkedItemId" value="@Model.PromptJournalId" />
                    <input type="hidden" name="promptType" value="@Model.PromptJournalType" />
                    <button type="submit" class="btn btn-cms">
                        <i class="bi bi-journal-plus me-1"></i>Ja, Journaleintrag erstellen
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
<script>
function projToggleEdit(entryId) {
    // Beim Bearbeiten den Collapse zuerst aufmachen
    var body = document.getElementById('jBody-' + entryId);
    if (body && !body.classList.contains('show')) {
        bootstrap.Collapse.getOrCreateInstance(body).show();
    }
    document.getElementById('view-' + entryId).classList.toggle('d-none');
    document.getElementById('edit-' + entryId).classList.toggle('d-none');
}

// Journal-Header: manueller Toggle – ignoriert Klicks auf Links, Buttons und Formulare
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.journal-header[data-journal-target]').forEach(function (header) {
        var targetId = header.getAttribute('data-journal-target');
        var target = document.querySelector(targetId);
        var chevron = header.querySelector('.journal-chevron');
        if (!target) return;

        // Chevron-Animation bei Collapse-Events
        if (chevron) {
            target.addEventListener('show.bs.collapse', function () {
                chevron.style.transform = 'rotate(-180deg)';
                header.setAttribute('aria-expanded', 'true');
            });
            target.addEventListener('hide.bs.collapse', function () {
                chevron.style.transform = 'rotate(0deg)';
                header.setAttribute('aria-expanded', 'false');
            });
        }

        // Click auf Header: Toggle nur wenn kein Link / Button / Form angeklickt
        header.addEventListener('click', function (e) {
            if (e.target.closest('a, button, form')) return;
            bootstrap.Collapse.getOrCreateInstance(target).toggle();
        });
    });

    // Journal-Prompt Modal automatisch anzeigen
    var promptModal = document.getElementById('modalJournalPrompt');
    if (promptModal) {
        bootstrap.Modal.getOrCreateInstance(promptModal).show();
    }

    // Journaleintrag automatisch im Edit-Modus öffnen (nach Erstellung)
    var openEntry = '@Model.OpenEntryId';
    if (openEntry) {
        // Kurze Verzögerung damit Collapse initialisiert ist
        setTimeout(function () {
            projToggleEdit(openEntry);
            var el = document.getElementById('entry-' + openEntry);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 150);
    }
});
</script>
@if (Model.CanEdit)
{
    <link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-bs5.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-bs5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/lang/summernote-de-DE.min.js"></script>
    <script>
    $(document).ready(function () {
        var snOpts = {
            lang: 'de-DE',
            height: 250,
            linkTargetBlank: true,
            toolbar: [
                ['font',  ['bold', 'italic', 'underline', 'clear']],
                ['para',  ['ul', 'ol']],
                ['insert',['link', 'hr']],
                ['view',  ['codeview']]
            ]
        };
        $('#newJournalContent').summernote(snOpts);
        $('textarea[id^="editContent-"]').each(function () {
            $(this).summernote(snOpts);
        });
        $('form').on('submit', function () {
            $(this).find('textarea[id^="editContent-"], #newJournalContent').each(function () {
                if ($(this).data('summernote')) {
                    $(this).val($(this).summernote('code'));
                    $(this).show();
                }
            });
        });
    });
    </script>
}
}
