@page
@model MyCMS2026.Pages.Admin.ImagesModel
@{
    ViewData["Title"] = "Bilder verwalten";
    var pathBase = HttpContext.Request.PathBase.Value?.TrimEnd('/') ?? "";
}

<div class="cms-page-header d-flex justify-content-between align-items-center">
    <h1 class="cms-page-title">
        <i class="bi bi-images me-2 fs-4"></i>Bilder verwalten
        <span class="badge bg-secondary ms-2 fs-6 fw-normal">@Model.Images.Count</span>
    </h1>
    <a asp-page="/Widgets/_wAdmin" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Admin
    </a>
</div>

<div class="cms-page-body">

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert @(Model.IsError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <p class="text-muted small mb-4">
        Hochgeladene Bilder aus HTML- und Home-Widgets. Die Spalte «Verwendet in» zeigt welche Pages das Bild referenzieren.
        <span class="badge bg-warning text-dark ms-1">Nicht verwendet</span> markiert verwaiste Bilder.
    </p>

    @if (!Model.Images.Any())
    {
        <div class="alert alert-light border text-center py-5">
            <i class="bi bi-images fs-1 text-muted d-block mb-2"></i>
            Noch keine Bilder hochgeladen.
        </div>
    }
    else
    {
        @* Lösch-Formulare *@
        @foreach (var img in Model.Images)
        {
            <form id="del-@img.FileName.GetHashCode()" method="post"
                  asp-page-handler="Delete" style="display:none">
                <input type="hidden" name="fileName" value="@img.FileName" />
            </form>
        }

        <div class="row g-3">
            @foreach (var img in Model.Images)
            {
                var imgUrl = $"{pathBase}/img/{img.FileName}";
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="bg-light d-flex align-items-center justify-content-center"
                             style="height:160px;overflow:hidden;border-radius:.375rem .375rem 0 0;">
                            <img src="@imgUrl" alt="@img.FileName"
                                 style="max-width:100%;max-height:160px;object-fit:contain;" />
                        </div>
                        <div class="card-body p-2">
                            <div class="small fw-semibold text-truncate" title="@img.FileName">
                                @img.FileName
                            </div>
                            <div class="text-muted" style="font-size:.75rem;">
                                @img.SizeKb KB &nbsp;·&nbsp; @img.LastModified.ToString("dd.MM.yy HH:mm")
                            </div>
                            <div class="mt-1">
                                @if (img.IsOrphaned)
                                {
                                    <span class="badge bg-warning text-dark" style="font-size:.7rem;">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Nicht verwendet
                                    </span>
                                }
                                else
                                {
                                    @foreach (var pageName in img.UsedInPages)
                                    {
                                        <span class="badge bg-success" style="font-size:.7rem;">
                                            <i class="bi bi-file-earmark-text me-1"></i>@pageName
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                        <div class="card-footer p-2 d-flex gap-1 border-0">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary flex-grow-1"
                                    onclick="navigator.clipboard.writeText('@imgUrl'); this.textContent='✓ Kopiert'; setTimeout(()=>this.innerHTML='<i class=\'bi bi-clipboard\'></i> URL',1500)">
                                <i class="bi bi-clipboard"></i> URL
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="cmsConfirmDelete('del-@img.FileName.GetHashCode()', 'Bild «@img.FileName» löschen?')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
