@page
@model MyCMS2026.Pages.ErrorModel
@{
    ViewData["Title"] = "Fehler";
}
<div class="container mt-5 text-center">
    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:3rem;"></i>
    <h4 class="mt-3">Ein Fehler ist aufgetreten</h4>
    <p class="text-muted">Request ID: <code>@Model.RequestId</code></p>
    <a asp-page="/Index" class="btn btn-cms">Zur Startseite</a>
</div>
