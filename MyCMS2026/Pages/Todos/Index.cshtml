@page
@model MyCMS2026.Pages.Todos.TodosIndexModel
@inject MyCMS2026.Services.KlassenService KlassenSvc
@{
    ViewData["Title"] = "ToDo Verwaltung";
    var isAdmin = User.IsInRole("Administrator");
    var gruppe  = Model.Gruppe;
    var todoKlassen = await KlassenSvc.GetKlassenAsync("todos");
}

@* Delete-Forms ausserhalb der Tabelle *@
@foreach (var t in Model.Todos)
{
    <form id="delForm-@t.Id" method="post" asp-page-handler="Delete" style="display:none">
        <input type="hidden" name="id" value="@t.Id" />
        <input type="hidden" name="gruppe" value="@gruppe" />
    </form>
}


<div class="cms-page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="cms-page-title">
        <i class="bi bi-check2-square me-2"></i>ToDo Verwaltung
        @if (!string.IsNullOrEmpty(gruppe))
        {
            <span class="badge bg-secondary fs-6 fw-normal ms-2">@gruppe</span>
        }
    </h1>
    @if (isAdmin)
    {
        <a asp-page="Edit" asp-route-gruppe="@gruppe" class="btn btn-cms btn-sm">
            <i class="bi bi-plus-circle me-1"></i>Neuen Task anlegen
        </a>
    }
</div>
<div class="cms-page-body">

    <div class="cms-filter-bar">
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="gruppe" value="@gruppe" />
            <div class="col-sm-4 col-md-3">
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Suchen..." />
            </div>
            <div class="col-sm-3 col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">Alle</option>
                    <option value="offen" selected="@(Model.StatusFilter == "offen" ? "selected" : null)">Offen</option>
                    <option value="erledigt" selected="@(Model.StatusFilter == "erledigt" ? "selected" : null)">Erledigt</option>
                </select>
            </div>
            <div class="col-sm-3 col-md-2">
                <select name="klasse" class="form-select form-select-sm">
                    <option value="">Alle Klassen</option>
                    @foreach (var k in todoKlassen)
                    {
                        <option value="@k" selected="@(Model.KlasseFilter == k ? "selected" : null)">@k</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-cms btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-page="Index" asp-route-gruppe="@gruppe" class="btn btn-outline-secondary btn-sm ms-1">Reset</a>
            </div>
        </form>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="text-muted" style="width:50px;">#</th>
                            <th>Thema</th>
                            <th>Verantwortlich</th>
                            <th>Anlagedatum</th>
                            <th>Erledigen bis</th>
                            <th>Status</th>
                            <th>Dateien</th>
                            <th>Klasse / Gruppe</th>
                            <th class="text-end">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Todos.Any())
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">Keine Tasks gefunden.</td></tr>
                        }
                        @foreach (var t in Model.Todos)
                        {
                            var diff = (t.ErledigenBis - DateTime.Today).Days;
                            string rowClass;
                            if (t.Erledigt)        rowClass = "table-success";
                            else if (diff < 0)     rowClass = "table-danger";
                            else if (diff <= 7)    rowClass = "table-warning";
                            else                   rowClass = "";
                            <tr class="@rowClass">
                                <td class="text-muted small">@t.TaskNr</td>
                                <td class="fw-semibold">@t.Thema
                                    @if (t.Files.Any())
                                    {
                                        <span class="badge bg-light text-muted border ms-1" title="@t.Files.Count Datei(en)"><i class="bi bi-paperclip"></i> @t.Files.Count</span>
                                    }
                                </td>
                                <td>@t.Verantwortlich</td>
                                <td>@t.Anlagedatum.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @t.ErledigenBis.ToString("dd.MM.yyyy")
                                    @if (!t.Erledigt && diff < 0)
                                    {
                                        <span class="badge bg-danger ms-1">@Math.Abs(diff)d überfällig</span>
                                    }
                                    else if (!t.Erledigt && diff <= 7)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">in @diff Tagen</span>
                                    }
                                </td>
                                <td>
                                    @if (t.Erledigt)
                                    {
                                        <span class="badge badge-erledigt">Erledigt</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-offen">Offen</span>
                                    }
                                </td>
                                <td>@t.Files.Count</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(t.Klasse))
                                    {
                                        <span class="badge bg-light text-dark border me-1">@t.Klasse</span>
                                    }
                                    @if (!string.IsNullOrEmpty(t.Gruppe))
                                    {
                                        <span class="badge bg-secondary">@t.Gruppe</span>
                                    }
                                </td>
                                <td class="text-end" onclick="event.stopPropagation()" style="white-space:nowrap">
                                    <a asp-page="Detail" asp-route-id="@t.Id" asp-route-gruppe="@gruppe"
                                       class="btn btn-sm btn-outline-primary" title="Öffnen">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form method="post" asp-page-handler="Toggle" style="display:inline">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <input type="hidden" name="gruppe" value="@gruppe" />
                                        <button class="btn btn-sm @(t.Erledigt ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(t.Erledigt ? "Als offen markieren" : "Als erledigt markieren")">
                                            <i class="bi bi-@(t.Erledigt ? "arrow-counterclockwise" : "check-circle")"></i>
                                        </button>
                                    </form>
                                    @if (isAdmin)
                                    {
                                        <a asp-page="Edit" asp-route-id="@t.Id" asp-route-gruppe="@gruppe"
                                           class="btn btn-sm btn-outline-secondary" title="Bearbeiten">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Löschen"
                                                onclick="cmsConfirmDelete('delForm-@t.Id', '@t.Thema.Replace("'", "\\'") löschen?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

