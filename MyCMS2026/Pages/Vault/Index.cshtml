@page
@model MyCMS2026.Pages.Vault.VaultIndexModel
@{
    ViewData["Title"] = "Vault" + (string.IsNullOrEmpty(Model.Gruppe) ? "" : $" – {Model.Gruppe}");
    var isAdmin    = User.IsInRole("Administrator");
    var gruppe     = Model.Gruppe ?? "";
    var subfolders = Model.Folders.Where(f => !f.IsRoot).Select(f => f.FolderName).ToList();
}

<div class="cms-page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="cms-page-title">
        <i class="bi bi-safe me-2"></i>Vault
        @if (!string.IsNullOrEmpty(gruppe))
        {
            <span class="badge bg-secondary fs-6 fw-normal ms-2">@gruppe</span>
        }
    </h1>
    @if (isAdmin)
    {
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#newFolderPanel">
                <i class="bi bi-folder-plus me-1"></i>Neuer Ordner
            </button>
            <button class="btn btn-cms btn-sm" data-bs-toggle="collapse" data-bs-target="#uploadPanel">
                <i class="bi bi-upload me-1"></i>Hochladen
            </button>
        </div>
    }
</div>
<div class="cms-page-body">

    @* Neuer Ordner *@
    @if (isAdmin)
    {
        <div class="collapse mb-3" id="newFolderPanel">
            <div class="card">
                <div class="card-body py-2">
                    <form method="post" asp-page-handler="CreateFolder" class="d-flex gap-2 align-items-center">
                        <input type="hidden" name="gruppe" value="@gruppe" />
                        <i class="bi bi-folder-plus text-muted fs-5"></i>
                        <input type="text" name="folderName" class="form-control form-control-sm flex-fill"
                               placeholder="Ordnername..." maxlength="60" required />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-check-lg me-1"></i>Erstellen
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="collapse mb-3" id="uploadPanel">
            <div class="card">
                <div class="card-header card-header-cms">
                    <i class="bi bi-upload me-2"></i>Datei hochladen
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                        <input type="hidden" name="gruppe" value="@gruppe" />
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Ordner</label>
                                <select name="subfolder" class="form-select form-select-sm">
                                    <option value="">(Hauptordner)</option>
                                    @foreach (var sub in subfolders)
                                    {
                                        <option value="@sub">📁 @sub</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Datei <span class="text-danger">*</span></label>
                                <input type="file" name="uploadFile" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Beschreibung</label>
                                <input type="text" name="description" class="form-control form-control-sm" placeholder="Kurze Beschreibung..." />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-cms btn-sm mt-3">
                            <i class="bi bi-cloud-upload me-1"></i>Hochladen
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }

    @* Suche *@
    <div class="cms-filter-bar mb-3">
        <form method="get" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="gruppe" value="@gruppe" />
            <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm"
                   placeholder="Dateiname oder Beschreibung suchen..." style="max-width:360px;" />
            <button type="submit" class="btn btn-cms btn-sm"><i class="bi bi-search"></i></button>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a asp-page="Index" asp-route-gruppe="@gruppe" class="btn btn-outline-secondary btn-sm">Reset</a>
            }
        </form>
    </div>

    @* Ordner + Dateien *@
    @if (!Model.Folders.Any() || Model.Folders.All(f => !f.Files.Any()))
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-safe2 fs-1"></i>
            <p class="mt-2">Noch keine Dateien vorhanden.</p>
        </div>
    }
    else
    {
        var fi = 0;
        foreach (var folder in Model.Folders)
        {
            if (!folder.Files.Any() && !folder.IsRoot) { fi++; continue; }
            var collapseId = folder.IsRoot ? "vault-root" : $"vault-sub-{fi++}";
            var colCount   = isAdmin ? 6 : 5;
            <div class="card mb-3">
                @if (folder.IsRoot)
                {
                    <div class="card-header d-flex align-items-center gap-2 py-2">
                        <i class="bi bi-folder2-open text-warning"></i>
                        <span class="fw-semibold">Hauptordner</span>
                        <span class="badge bg-secondary ms-1">@folder.Files.Count</span>
                    </div>
                }
                else
                {
                    <div class="card-header d-flex align-items-center gap-2 py-2"
                         role="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor:pointer;">
                        <i class="bi bi-folder-fill text-warning"></i>
                        <span class="fw-semibold flex-fill">@folder.FolderName</span>
                        <span class="badge bg-secondary">@folder.Files.Count</span>
                        <i class="bi bi-chevron-down text-muted small"></i>
                        @if (isAdmin)
                        {
                            <form method="post" asp-page-handler="DeleteFolder" class="ms-2">
                                <input type="hidden" name="folderName" value="@folder.FolderName" />
                                <input type="hidden" name="gruppe" value="@gruppe" />
                                <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1"
                                        title="Ordner löschen"
                                        onclick="event.stopPropagation(); cmsConfirmDelete(this.closest('form'), 'Ordner «@folder.FolderName.Replace("'", "\\'")» und alle Dateien löschen?')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                }

                <div class="@(folder.IsRoot ? "" : "collapse")" id="@collapseId">
                    @if (!folder.Files.Any())
                    {
                        <div class="card-body text-muted small py-2">
                            <i class="bi bi-inbox me-1"></i>Keine Dateien.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:40px;"></th>
                                        <th>Dateiname</th>
                                        <th>Beschreibung</th>
                                        <th class="text-end">Grösse</th>
                                        <th class="text-center">Datum</th>
                                        @if (isAdmin) { <th class="text-center">Aktionen</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in folder.Files)
                                    {
                                        var ext  = System.IO.Path.GetExtension(f.FileName).TrimStart('.').ToLowerInvariant();
                                        var icon = ext switch {
                                            "pdf"  => "bi-file-earmark-pdf text-danger",
                                            "doc" or "docx" => "bi-file-earmark-word text-primary",
                                            "xls" or "xlsx" => "bi-file-earmark-excel text-success",
                                            "ppt" or "pptx" => "bi-file-earmark-ppt text-warning",
                                            "jpg" or "jpeg" or "png" or "gif" => "bi-file-earmark-image text-info",
                                            "zip" or "rar"  => "bi-file-earmark-zip text-secondary",
                                            _ => "bi-file-earmark text-muted"
                                        };
                                        var safeKey = System.Text.RegularExpressions.Regex.Replace(
                                            (folder.IsRoot ? "" : folder.FolderName + "_") + f.FileName,
                                            @"[^a-zA-Z0-9]", "_");
                                        var rowId = $"vf-{safeKey}";

                                        <tr>
                                            <td class="text-center"><i class="bi @icon fs-5"></i></td>
                                            <td>
                                                <a asp-page="/Vault/File"
                                                   asp-route-gruppe="@gruppe"
                                                   asp-route-subfolder="@folder.FolderName"
                                                   asp-route-fileName="@f.FileName"
                                                   class="text-decoration-none fw-semibold">@f.FileName</a>
                                                @if (isAdmin)
                                                {
                                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-muted"
                                                            onclick="vaultToggle('rename-@rowId')" title="Umbenennen">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                }
                                            </td>
                                            <td class="text-muted small">
                                                <span id="txt-@rowId">@f.Description</span>
                                                @if (isAdmin)
                                                {
                                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-muted"
                                                            onclick="vaultToggle('edit-@rowId')" title="Beschreibung bearbeiten">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                }
                                            </td>
                                            <td class="text-end text-muted small">@f.SizeText</td>
                                            <td class="text-center text-muted small">@f.UploadedAt.ToString("dd.MM.yyyy")</td>
                                            @if (isAdmin)
                                            {
                                                <td class="text-center">
                                                    <form method="post" asp-page-handler="Delete">
                                                        <input type="hidden" name="fileName" value="@f.FileName" />
                                                        <input type="hidden" name="subfolder" value="@folder.FolderName" />
                                                        <input type="hidden" name="gruppe" value="@gruppe" />
                                                        <button type="button" class="btn btn-outline-danger btn-sm" title="Löschen"
                                                                onclick="cmsConfirmDelete(this.closest('form'), '@f.FileName.Replace("'", "\\'") löschen?')">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>

                                        @if (isAdmin)
                                        {
                                            <tr id="edit-@rowId" class="d-none bg-light">
                                                <td colspan="@colCount" class="py-2 px-3">
                                                    <form method="post" asp-page-handler="UpdateDescription" class="d-flex gap-2 align-items-center">
                                                        <input type="hidden" name="fileName" value="@f.FileName" />
                                                        <input type="hidden" name="subfolder" value="@folder.FolderName" />
                                                        <input type="hidden" name="gruppe" value="@gruppe" />
                                                        <input type="text" name="description" value="@f.Description"
                                                               class="form-control form-control-sm flex-fill" placeholder="Beschreibung..." />
                                                        <button type="submit" class="btn btn-cms btn-sm"><i class="bi bi-check-lg"></i></button>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                                onclick="vaultToggle('edit-@rowId')"><i class="bi bi-x"></i></button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <tr id="rename-@rowId" class="d-none table-warning">
                                                <td colspan="@colCount" class="py-2 px-3">
                                                    <form method="post" asp-page-handler="Rename" class="d-flex gap-2 align-items-center"
                                                          onsubmit="return confirm('Datei umbenennen?')">
                                                        <input type="hidden" name="fileName" value="@f.FileName" />
                                                        <input type="hidden" name="subfolder" value="@folder.FolderName" />
                                                        <input type="hidden" name="gruppe" value="@gruppe" />
                                                        <i class="bi bi-pencil-square text-warning-emphasis"></i>
                                                        <input type="text" name="newName" value="@f.FileName"
                                                               class="form-control form-control-sm flex-fill" required />
                                                        <button type="submit" class="btn btn-warning btn-sm">
                                                            <i class="bi bi-check-lg me-1"></i>Umbenennen
                                                        </button>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                                onclick="vaultToggle('rename-@rowId')"><i class="bi bi-x"></i></button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
<script>
function vaultToggle(id) {
    var el = document.getElementById(id);
    if (el) el.classList.toggle('d-none');
}
</script>
}
