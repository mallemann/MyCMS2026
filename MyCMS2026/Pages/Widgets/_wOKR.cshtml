@model MyCMS2026.Pages.Page.PageIndexModel
@using MyCMS2026.Services
@using MyCMS2026.Models
@inject OkrService OkrSvc
@inject WeeklyMailService WeeklyMailSvc
@inject GruppenService GruppenSvc
@{
    var isAdmin = User.IsInRole("Administrator");
    var pageId  = Model.Id;

    // Gruppen des aktuellen Benutzers aus Reporting Settings
    var okrUserName  = User.Identity?.Name ?? "";
    var okrAllowedGruppen = await WeeklyMailSvc.GetAllowedGruppenAsync(okrUserName);
    var okrFilterByGroup  = okrAllowedGruppen.Any();

    // Gruppen-Liste für Admin-Dropdowns
    var alleGruppen = await GruppenSvc.GetAllAsync();

    // Jahr aus Query-String, Fallback auf aktuelles Jahr
    var allYears    = await OkrSvc.GetYearsAsync();
    var currentYear = DateTime.Now.Year;
    if (int.TryParse(Context.Request.Query["okrYear"].ToString(), out int qYear) && qYear > 0)
        currentYear = qYear;
    if (!allYears.Contains(currentYear)) allYears.Add(currentYear);
    allYears = allYears.OrderByDescending(y => y).ToList();

    var showAll  = Context.Request.Query["showAll"].ToString() == "true";
    var all      = await OkrSvc.GetByYearAsync(currentYear);

    // Sichtbarkeit: Access-Gruppen (welche Daten) + ConfigString verengt auf eine Gruppe
    var okrGruppe = Model.NavItem?.ConfigString ?? "";
    bool CanSeeGr(string? g)
    {
        if (isAdmin) return string.IsNullOrWhiteSpace(okrGruppe) || string.Equals(g, okrGruppe, StringComparison.OrdinalIgnoreCase);
        if (!okrAllowedGruppen.Any()) return false;
        if (!string.IsNullOrWhiteSpace(okrGruppe))
            return string.Equals(g, okrGruppe, StringComparison.OrdinalIgnoreCase) && okrAllowedGruppen.Contains(g, StringComparer.OrdinalIgnoreCase);
        return !string.IsNullOrEmpty(g) && okrAllowedGruppen.Contains(g, StringComparer.OrdinalIgnoreCase);
    }
    all = all.Where(o => CanSeeGr(o.Gruppe)).ToList();

    var objectives = showAll ? all : all.Where(o => o.Status == "aktiv").ToList();
}

@if (!isAdmin && !okrAllowedGruppen.Any())
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Sie sind keiner Gruppe zugeordnet – bitte Administrator kontaktieren.</div>
    return;
}

@* Jahr-Navigation + Filter *@
<div class="mb-3 d-flex align-items-center gap-2 flex-wrap">
    <div class="d-flex align-items-center gap-1">
        @foreach (var y in allYears)
        {
            var active = y == currentYear;
            <a href="?Id=@pageId&okrYear=@y&showAll=@showAll"
               class="btn btn-sm @(active ? "btn-cms" : "btn-outline-secondary")">@y</a>
        }
    </div>
    <div class="form-check ms-2 mb-0">
        <input class="form-check-input" type="checkbox" id="wOkrShowAll"
               @(showAll ? "checked" : "")
               onchange="location.href='?Id=@pageId&okrYear=@currentYear&showAll='+(this.checked?'true':'false')" />
        <label class="form-check-label small" for="wOkrShowAll">Abgeschlossene anzeigen</label>
    </div>
    @if (isAdmin)
    {
        <button class="btn btn-cms btn-sm ms-auto" data-bs-toggle="modal" data-bs-target="#wOkrModalNew">
            <i class="bi bi-plus-circle me-1"></i>Neues Objective
        </button>
    }
</div>

@if (!objectives.Any())
{
    <div class="alert alert-info">Keine OKRs für die gewählte Auswahl vorhanden.</div>
}

@foreach (var obj in objectives)
{
    var totalProgress = obj.KeyResults.Any()
        ? obj.KeyResults.Average(kr => kr.ProgressPercent)
        : 0.0;
    string progressColor;
    if      (totalProgress >= 80) progressColor = "success";
    else if (totalProgress >= 50) progressColor = "warning";
    else                          progressColor = "danger";

    <div class="card okr-card">
        <div class="card-header card-header-cms d-flex justify-content-between align-items-start">
            <div>
                <div class="fw-semibold text-white">@obj.Text</div>
                <div class="mt-1">
                    <span class="badge bg-light text-dark me-1">@obj.Year</span>
                    <span class="badge @(obj.Status == "aktiv" ? "bg-success" : "bg-secondary")">@obj.Status</span>
                    @if (!string.IsNullOrEmpty(obj.Gruppe))
                    {
                        <span class="badge bg-light text-dark border ms-1"><i class="bi bi-people me-1"></i>@obj.Gruppe</span>
                    }
                </div>
            </div>
            @if (isAdmin)
            {
                <div class="d-flex gap-1 ms-2">
                    <button class="btn btn-sm btn-outline-light"
                            data-obj-id="@obj.Id" data-obj-text="@obj.Text"
                            data-obj-status="@obj.Status" data-obj-year="@obj.Year"
                            data-obj-gruppe="@obj.Gruppe"
                            onclick="wOkrEditObjective(this)">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <form id="wOkrDelObj-@obj.Id" method="post" asp-page="/Okr/Index" asp-page-handler="DeleteObjective" style="display:none">
                        <input type="hidden" name="objectiveId" value="@obj.Id" />
                        <input type="hidden" name="returnPageId" value="@pageId" />
                        <input type="hidden" name="okrYear" value="@currentYear" />
                    </form>
                    <button class="btn btn-sm btn-outline-light"
                            onclick="cmsConfirmDelete('wOkrDelObj-@obj.Id', 'Objective «@obj.Text.Replace("'", "\\'")» löschen?'); return false;">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            }
        </div>
        <div class="card-body">
            <div class="mb-3">
                <div class="d-flex justify-content-between small mb-1">
                    <span class="text-muted">Gesamtfortschritt</span>
                    <strong>@totalProgress.ToString("0.#")%</strong>
                </div>
                <div class="progress okr-progress-bar">
                    <div class="progress-bar bg-@progressColor" style="width:@totalProgress%"></div>
                </div>
            </div>

            @if (obj.KeyResults.Any())
            {
                <table class="table table-sm align-middle mb-2">
                    <thead class="table-light">
                        <tr>
                            <th>Key Result</th>
                            <th class="text-center" style="width:100px">Ziel</th>
                            <th class="text-center" style="width:120px">Aktuell</th>
                            <th style="width:150px">Fortschritt</th>
                            @if (isAdmin) { <th class="text-end" style="width:60px"></th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kr in obj.KeyResults)
                        {
                            string krColor;
                            if      (kr.ProgressPercent >= 80) krColor = "success";
                            else if (kr.ProgressPercent >= 50) krColor = "warning";
                            else                               krColor = "danger";
                            <tr>
                                <td>@kr.Text</td>
                                <td class="text-center">@kr.TargetValue.ToString("N0")</td>
                                <td class="text-center">
                                    @if (isAdmin)
                                    {
                                        <form method="post" asp-page="/Okr/Index" asp-page-handler="UpdateProgress"
                                              class="d-flex gap-1 justify-content-center">
                                            <input type="hidden" name="objectiveId" value="@obj.Id" />
                                            <input type="hidden" name="krId"        value="@kr.Id" />
                                            <input type="hidden" name="returnPageId" value="@pageId" />
                                            <input type="hidden" name="okrYear"     value="@currentYear" />
                                            <input type="number" name="current" value="@kr.CurrentValue" step="0.1"
                                                   class="form-control form-control-sm text-center" style="width:75px;" />
                                            <button class="btn btn-sm btn-outline-secondary" title="Aktualisieren">↻</button>
                                        </form>
                                    }
                                    else
                                    {
                                        @kr.CurrentValue.ToString("N0")
                                    }
                                </td>
                                <td>
                                    <div class="progress" style="height:14px;">
                                        <div class="progress-bar bg-@krColor" style="width:@kr.ProgressPercent%"></div>
                                    </div>
                                    <div class="text-end small text-muted">@kr.ProgressPercent.ToString("0.#")%</div>
                                </td>
                                @if (isAdmin)
                                {
                                    <td class="text-end">
                                        <form id="wOkrDelKr-@kr.Id" method="post" asp-page="/Okr/Index" asp-page-handler="DeleteKr" style="display:none">
                                            <input type="hidden" name="objectiveId"  value="@obj.Id" />
                                            <input type="hidden" name="krId"         value="@kr.Id" />
                                            <input type="hidden" name="returnPageId" value="@pageId" />
                                            <input type="hidden" name="okrYear"      value="@currentYear" />
                                        </form>
                                        <button class="btn btn-sm btn-outline-danger"
                                                onclick="cmsConfirmDelete('wOkrDelKr-@kr.Id', 'Key Result «@kr.Text.Replace("'", "\\'")» löschen?'); return false;">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted small">Noch keine Key Results angelegt.</p>
            }

            @if (isAdmin)
            {
                <form method="post" asp-page="/Okr/Index" asp-page-handler="AddKr"
                      class="row g-2 align-items-end mt-1">
                    <input type="hidden" name="objectiveId"  value="@obj.Id" />
                    <input type="hidden" name="returnPageId" value="@pageId" />
                    <input type="hidden" name="okrYear"      value="@currentYear" />
                    <div class="col-sm-5">
                        <input type="text" name="krText" class="form-control form-control-sm"
                               placeholder="Neues Key Result..." required />
                    </div>
                    <div class="col-sm-3">
                        <input type="number" name="target" step="0.1" class="form-control form-control-sm"
                               placeholder="Zielwert" required />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-cms"><i class="bi bi-plus me-1"></i>Key Result</button>
                    </div>
                </form>
            }
        </div>
    </div>
}

@if (isAdmin)
{
    @* Modal: Neues Objective *@
    <div class="modal fade" id="wOkrModalNew" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header card-header-cms rounded-0">
                    <h5 class="modal-title text-white">Neues Objective</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-page="/Okr/Index" asp-page-handler="AddObjective">
                    <input type="hidden" name="returnPageId" value="@pageId" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Objective Text *</label>
                            <textarea name="text" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Jahr</label>
                                <select name="year" class="form-select">
                                    @for (var y = DateTime.Now.Year + 1; y >= DateTime.Now.Year - 3; y--)
                                    {
                                        <option value="@y" selected="@(y == currentYear)">@y</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">Gruppe</label>
                                @if (!string.IsNullOrWhiteSpace(okrGruppe))
                                {
                                    <input type="text" class="form-control" value="@okrGruppe" readonly />
                                    <input type="hidden" name="gruppe" value="@okrGruppe" />
                                }
                                else
                                {
                                    <select name="gruppe" class="form-select" required>
                                        <option value="">– Gruppe wählen –</option>
                                        @foreach (var g in alleGruppen)
                                        {
                                            <option value="@g">@g</option>
                                        }
                                    </select>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
                        <button type="submit" class="btn btn-cms">Anlegen</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* Modal: Objective bearbeiten *@
    <div class="modal fade" id="wOkrModalEdit" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header card-header-cms rounded-0">
                    <h5 class="modal-title text-white">Objective bearbeiten</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-page="/Okr/Index" asp-page-handler="EditObjective">
                    <input type="hidden" name="returnPageId" value="@pageId" />
                    <input type="hidden" name="okrYear"      value="@currentYear" />
                    <div class="modal-body">
                        <input type="hidden" name="objectiveId" id="wOkrEditId" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Text *</label>
                            <textarea name="text" id="wOkrEditText" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Status</label>
                                <select name="status" id="wOkrEditStatus" class="form-select">
                                    <option value="aktiv">aktiv</option>
                                    <option value="abgeschlossen">abgeschlossen</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">Jahr</label>
                                <input type="number" name="year" id="wOkrEditYear" class="form-control" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label fw-semibold">Gruppe</label>
                            <select name="gruppe" id="wOkrEditGruppe" class="form-select">
                                <option value="">– für alle sichtbar –</option>
                                @foreach (var g in alleGruppen)
                                {
                                    <option value="@g">@g</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
                        <button type="submit" class="btn btn-cms">Speichern</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<script>
function wOkrEditObjective(btn) {
    document.getElementById('wOkrEditId').value     = btn.dataset.objId;
    document.getElementById('wOkrEditText').value   = btn.dataset.objText;
    document.getElementById('wOkrEditStatus').value = btn.dataset.objStatus;
    document.getElementById('wOkrEditYear').value   = btn.dataset.objYear;
    document.getElementById('wOkrEditGruppe').value = btn.dataset.objGruppe || '';
    new bootstrap.Modal(document.getElementById('wOkrModalEdit')).show();
}
</script>
