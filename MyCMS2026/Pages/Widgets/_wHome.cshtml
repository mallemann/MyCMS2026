@model MyCMS2026.Pages.Page.PageIndexModel
@using MyCMS2026.Models
@inject MyCMS2026.Services.SiteService SiteSvc
@inject MyCMS2026.Services.TodoService TodoSvc
@inject MyCMS2026.Services.MeetingService MeetingSvc
@inject MyCMS2026.Services.WeeklyMailService WeeklyMailSvc
@inject IWebHostEnvironment Env
@{
    var site     = await SiteSvc.GetAsync();
    var pageFile = "home.html";
    var path = System.IO.Path.Combine(Env.ContentRootPath, "App_Data", "pages", pageFile);
    var html = System.IO.File.Exists(path) ? System.IO.File.ReadAllText(path) : null;

    // Reporting-Filter
    var userName       = User.Identity?.Name ?? "";
    var isAdmin        = User.IsInRole("Administrator");
    // Effektive Access-Gruppen des Users (Baseline minus deaktivierte Kontexte)
    var allowedGruppen = await WeeklyMailSvc.GetAllowedGruppenAsync(userName);
    var filterByGroup  = allowedGruppen.Any();

    bool InGroup(string? g) =>
        !filterByGroup ||
        string.IsNullOrEmpty(g) ||
        allowedGruppen.Contains(g, StringComparer.OrdinalIgnoreCase);

    // Tasks
    var allTodos = await TodoSvc.GetAllAsync();
    var todos = (isAdmin && !filterByGroup)
        ? allTodos
        : filterByGroup ? allTodos.Where(t => InGroup(t.Gruppe)).ToList() : new();

    var today      = DateTime.Today;
    var offeneTodos = todos.Where(t => !t.Erledigt).OrderBy(t => t.ErledigenBis).ToList();

    // Meetings
    var allMeetings = await MeetingSvc.GetAllAsync();
    var meetings = (isAdmin && !filterByGroup)
        ? allMeetings
        : filterByGroup ? allMeetings.Where(m => InGroup(m.Gruppe)).ToList() : new();

    var geplantteMeetings = meetings
        .Where(m => m.Status == "Geplant")
        .OrderBy(m => m.Datum).ToList();

    var timelineMeetings  = meetings.OrderByDescending(m => m.Datum).ToList();
    var ueberfaellig      = offeneTodos.Count(t => t.ErledigenBis.Date < today);
    var naechstesMeeting  = geplantteMeetings.FirstOrDefault(m => m.Datum.Date >= today);
    var geplantZukunft    = geplantteMeetings.Count(m => m.Datum.Date >= today);

    // Tasks in drei Fälligkeits-Töpfe: überfällig / bis Monatsende / danach
    var monatsEnde = new DateTime(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month));

    var buckets = new[]
    {
        (Key: "ueberfaellig", Titel: "Überfällig",   Icon: "bi-exclamation-triangle", Farbe: "text-danger",
         Items: offeneTodos.Where(t => t.ErledigenBis.Date <  today).ToList()),
        (Key: "monat",        Titel: "Diesen Monat", Icon: "bi-clock",                Farbe: "text-warning",
         Items: offeneTodos.Where(t => t.ErledigenBis.Date >= today && t.ErledigenBis.Date <= monatsEnde).ToList()),
        (Key: "spaeter",      Titel: "Später",       Icon: "bi-calendar3",            Farbe: "text-muted",
         Items: offeneTodos.Where(t => t.ErledigenBis.Date >  monatsEnde).ToList())
    };

    // Gruppen-Chips nur anbieten, wenn es überhaupt mehr als eine Gruppe gibt
    var gruppen = offeneTodos.Select(t => t.Gruppe)
                             .Where(g => !string.IsNullOrWhiteSpace(g))
                             .Distinct(StringComparer.OrdinalIgnoreCase)
                             .OrderBy(g => g).ToList();

    // «Nur meine»: Verantwortlich trägt das Kürzel, ältere Einträge den Benutzernamen (Muster aus _wToDo)
    var currentKuerzel = User.FindFirst("Kuerzel")?.Value ?? "";
    bool IstMeine(TodoItem t) =>
        (!string.IsNullOrEmpty(currentKuerzel) && t.Verantwortlich.Equals(currentKuerzel, StringComparison.OrdinalIgnoreCase)) ||
        (!string.IsNullOrEmpty(userName)       && t.Verantwortlich.Equals(userName,       StringComparison.OrdinalIgnoreCase));

    var hatIdentitaet = !string.IsNullOrEmpty(currentKuerzel) || !string.IsNullOrEmpty(userName);
    var meineCount    = offeneTodos.Count(IstMeine);
}

@* ── KPI-Kacheln (klickbar = Filter auf einen Fälligkeits-Topf) ── *@
@if (offeneTodos.Any() || geplantteMeetings.Any())
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <button type="button" class="card border-0 shadow-sm h-100 w-100 text-center py-3 px-2 @(offeneTodos.Any() ? "hm-kpi" : "")"
                    data-bucket="ueberfaellig" title="Nur überfällige Tasks zeigen">
                <div class="@(ueberfaellig > 0 ? "text-danger" : "text-muted") mb-1"><i class="bi bi-exclamation-triangle fs-3"></i></div>
                <div class="display-6 fw-bold lh-1 @(ueberfaellig > 0 ? "text-danger" : "text-muted")"
                     data-kpi="ueberfaellig">@ueberfaellig</div>
                <div class="text-muted small mt-1">Tasks überfällig</div>
            </button>
        </div>
        <div class="col-6 col-md-3">
            <button type="button" class="card border-0 shadow-sm h-100 w-100 text-center py-3 px-2 @(offeneTodos.Any() ? "hm-kpi" : "")"
                    data-bucket="monat" title="Nur Tasks bis Monatsende zeigen">
                <div class="text-warning mb-1"><i class="bi bi-clock fs-3"></i></div>
                <div class="display-6 fw-bold lh-1" data-kpi="monat">@buckets[1].Items.Count</div>
                <div class="text-muted small mt-1">Tasks diesen Monat</div>
            </button>
        </div>
        <div class="col-6 col-md-3">
            <button type="button" class="card border-0 shadow-sm h-100 w-100 text-center py-3 px-2 @(offeneTodos.Any() ? "hm-kpi" : "")"
                    data-bucket="" title="Alle offenen Tasks zeigen">
                <div class="text-cms mb-1"><i class="bi bi-check2-square fs-3"></i></div>
                <div class="display-6 fw-bold lh-1" data-kpi="offen">@offeneTodos.Count</div>
                <div class="text-muted small mt-1">Tasks offen total</div>
            </button>
        </div>
        <div class="col-6 col-md-3">
            @if (naechstesMeeting != null)
            {
                var daysUntil = (naechstesMeeting.Datum.Date - today).Days;
                <div class="card border-0 shadow-sm h-100 text-center py-3 px-2">
                    <a asp-page="/Meetings/Detail" asp-route-id="@naechstesMeeting.Id"
                       asp-route-returnPageId="@Model.NavItem?.Id"
                       class="text-decoration-none d-block">
                        <div class="text-success mb-1"><i class="bi bi-calendar-event fs-3"></i></div>
                        <div class="fs-5 fw-bold lh-1">
                            @naechstesMeeting.Datum.ToString("dd. MMM")
                            <span class="small fw-normal @(daysUntil == 0 ? "text-warning" : "text-success")">
                                · @(daysUntil == 0 ? "heute" : $"in {daysUntil} Tag{(daysUntil == 1 ? "" : "en")}")
                            </span>
                        </div>
                        <div class="text-muted small mt-1">Nächstes Meeting</div>
                        <div class="small text-body text-truncate px-1">@naechstesMeeting.Thema</div>
                    </a>
                    <a asp-page="/Meetings/Index" asp-route-status="Geplant" asp-route-zukunft="true"
                       class="small text-decoration-none mt-2 pt-2 border-top d-block">
                        Alle geplanten Meetings <span class="badge bg-light text-dark border">@geplantZukunft</span>
                    </a>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm h-100 text-center py-3 px-2">
                    <div class="text-muted mb-1"><i class="bi bi-calendar-x fs-3"></i></div>
                    <div class="text-muted small mt-1">Kein Meeting geplant</div>
                </div>
            }
        </div>
    </div>
}

<div class="row mt-2">
    <div class="col-lg-8">

        @if (Model.HasExtendedAccess)
        {
            <div class="mb-2 text-end">
                <a asp-page="/Admin/EditHtmlPage"
                   asp-route-fileName="@pageFile"
                   asp-route-returnId="@Model.NavItem!.Id"
                   class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-pencil me-1"></i>Seite bearbeiten
                </a>
            </div>
        }

        @if (html != null)
        {
            <div class="cms-html-content">@Html.Raw(html)</div>
        }
        else if (Model.HasExtendedAccess)
        {
            <div class="alert alert-light border">
                <i class="bi bi-file-earmark-text me-2"></i>
                Noch kein Inhalt hinterlegt. Klicken Sie oben auf «Seite bearbeiten» um die Startseite zu gestalten.
            </div>
        }

    </div>
    <div class="col-lg-4 mt-3 mt-lg-0">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-cms text-white"><i class="bi bi-info-circle me-2"></i>System-Info</div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span>Angemeldet als</span>
                    <span class="text-muted">@Model.User.Identity?.Name</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Rolle</span>
                    <span class="text-muted">@string.Join(", ", Model.UserRoles)</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Version</span>
                    <span class="text-muted">MyCMS 2026</span>
                </li>
            </ul>
        </div>
    </div>
</div>

@* ── Offene Tasks nach Fälligkeit ──────────────────────────── *@
@if (offeneTodos.Any())
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h6 class="text-muted mb-0 me-2">
            <i class="bi bi-check2-square me-2"></i>Offene Tasks
        </h6>
        @if (gruppen.Count > 1)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary hm-chip" data-gruppe="">Alle Gruppen</button>
            @foreach (var g in gruppen)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary hm-chip" data-gruppe="@g">
                    @g <span class="text-muted">@offeneTodos.Count(t => string.Equals(t.Gruppe, g, StringComparison.OrdinalIgnoreCase))</span>
                </button>
            }
        }
        @if (hatIdentitaet)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary hm-toggle @(gruppen.Count > 1 ? "ms-2" : "")"
                    title="Nur Tasks zeigen, für die ich verantwortlich bin">
                <i class="bi bi-person me-1"></i>Nur meine <span class="text-muted">@meineCount</span>
            </button>
        }
    </div>

    <div class="row g-3">
        @foreach (var b in buckets)
        {
            <div class="col-lg-4 hm-bucket" data-bucket="@b.Key" data-expanded="0">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center small @b.Farbe mb-2">
                            <i class="bi @b.Icon me-2"></i>@b.Titel
                            <span class="ms-auto fw-bold hm-count">@b.Items.Count</span>
                        </div>

                        <div class="hm-empty text-muted small border-top pt-2 @(b.Items.Any() ? "d-none" : "")">
                            Keine Tasks.
                        </div>

                        @foreach (var t in b.Items)
                        {
                            <div class="hm-row border-top py-2" data-gruppe="@t.Gruppe" data-meine="@(IstMeine(t) ? "1" : "0")">
                                <a asp-page="/Todos/Detail" asp-route-id="@t.Id"
                                   asp-route-returnPageId="@Model.NavItem?.Id"
                                   class="text-decoration-none text-body d-block lh-sm">
                                    @t.Thema
                                </a>
                                <div class="small text-muted mt-1 d-flex flex-wrap align-items-center gap-1">
                                    <span>#@t.TaskNr</span>
                                    <span>·</span>
                                    <span>@t.ErledigenBis.ToString("dd.MM.yy")</span>
                                    @if (!string.IsNullOrEmpty(t.Verantwortlich))
                                    {
                                        <span>·</span>
                                        <span>@t.Verantwortlich</span>
                                    }
                                    @if (!string.IsNullOrEmpty(t.ProjectName))
                                    {
                                        <a href="@Url.Page("/Projects/Detail", new { id = t.ProjectId })"
                                           class="badge bg-light text-dark border text-decoration-none fw-normal ms-1">
                                            <i class="bi bi-kanban me-1"></i>@t.ProjectName
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        <button type="button" class="btn btn-link btn-sm p-0 mt-2 text-decoration-none hm-more d-none"></button>
                    </div>
                </div>
            </div>
        }
    </div>

    <style>
        .hm-kpi { cursor: pointer; background: var(--bs-card-bg, #fff); }
        .hm-kpi-active { outline: 2px solid var(--cms-accent); outline-offset: -2px; }
        .hm-chip.active, .hm-toggle.active { background: var(--cms-blue); border-color: var(--cms-blue); color: #fff; }
        .hm-chip.active .text-muted, .hm-toggle.active .text-muted { color: rgba(255,255,255,.75) !important; }
    </style>

    <script>
    (function () {
        var TOP = 5;
        var state = {
            gruppe: sessionStorage.getItem('mycms_home_gruppe') || '',
            bucket: sessionStorage.getItem('mycms_home_bucket') || '',
            meine:  sessionStorage.getItem('mycms_home_meine')  === '1'
        };

        function render() {
            var gesamt = 0, proTopf = {};

            document.querySelectorAll('.hm-bucket').forEach(function (col) {
                var key     = col.dataset.bucket;
                var expand  = col.dataset.expanded === '1';
                var rows    = Array.prototype.slice.call(col.querySelectorAll('.hm-row'));
                var treffer = rows.filter(function (r) {
                    if (state.gruppe && r.dataset.gruppe !== state.gruppe) { return false; }
                    if (state.meine  && r.dataset.meine  !== '1')          { return false; }
                    return true;
                });

                rows.forEach(function (r) { r.classList.add('d-none'); });
                treffer.forEach(function (r, i) {
                    if (expand || i < TOP) { r.classList.remove('d-none'); }
                });

                col.classList.toggle('d-none', !!state.bucket && state.bucket !== key);
                col.querySelector('.hm-count').textContent = treffer.length;
                col.querySelector('.hm-empty').classList.toggle('d-none', treffer.length > 0);

                var mehr = col.querySelector('.hm-more');
                var rest = treffer.length - TOP;
                if (rest > 0 || expand) {
                    mehr.classList.remove('d-none');
                    mehr.textContent = expand ? 'weniger anzeigen' : rest + ' weitere anzeigen';
                } else {
                    mehr.classList.add('d-none');
                }

                proTopf[key] = treffer.length;
                gesamt += treffer.length;
            });

            var set = function (name, wert) {
                var el = document.querySelector('[data-kpi="' + name + '"]');
                if (el) { el.textContent = wert; }
            };
            set('ueberfaellig', proTopf['ueberfaellig'] || 0);
            set('monat',        proTopf['monat']        || 0);
            set('offen',        gesamt);

            document.querySelectorAll('.hm-chip').forEach(function (c) {
                c.classList.toggle('active', (c.dataset.gruppe || '') === state.gruppe);
            });
            document.querySelectorAll('.hm-toggle').forEach(function (m) {
                m.classList.toggle('active', state.meine);
            });
            document.querySelectorAll('.hm-kpi').forEach(function (k) {
                k.classList.toggle('hm-kpi-active', !!state.bucket && k.dataset.bucket === state.bucket);
            });
        }

        document.querySelectorAll('.hm-chip').forEach(function (c) {
            c.addEventListener('click', function () {
                var g = c.dataset.gruppe || '';
                state.gruppe = (state.gruppe === g) ? '' : g;
                sessionStorage.setItem('mycms_home_gruppe', state.gruppe);
                render();
            });
        });

        document.querySelectorAll('.hm-toggle').forEach(function (m) {
            m.addEventListener('click', function () {
                state.meine = !state.meine;
                sessionStorage.setItem('mycms_home_meine', state.meine ? '1' : '0');
                render();
            });
        });

        document.querySelectorAll('.hm-kpi').forEach(function (k) {
            k.addEventListener('click', function () {
                var b = k.dataset.bucket || '';
                state.bucket = (state.bucket === b) ? '' : b;
                sessionStorage.setItem('mycms_home_bucket', state.bucket);
                render();
            });
        });

        document.querySelectorAll('.hm-bucket').forEach(function (col) {
            col.querySelector('.hm-more').addEventListener('click', function () {
                col.dataset.expanded = col.dataset.expanded === '1' ? '0' : '1';
                render();
            });
        });

        render();
    })();
    </script>
}

@* ── Meeting Timeline ──────────────────────────────────────── *@
@if (timelineMeetings.Any())
{
    <div class="mt-4">
        <h6 class="text-muted border-bottom pb-2 mb-3">
            <i class="bi bi-clock-history me-2"></i>Meeting-Timeline
        </h6>

        <div class="d-flex flex-wrap gap-2 mb-3">
            <select id="hmFilterStatus" class="form-select form-select-sm" style="width:auto;">
                <option value="">Alle Status</option>
                <option value="Geplant">Geplant</option>
                <option value="Abgeschlossen">Abgeschlossen</option>
                <option value="Abgesagt">Abgesagt</option>
            </select>
        </div>

        <div class="timeline" id="hmTimeline">
            @foreach (var m in timelineMeetings)
            {
                string badgeCls;
                if      (m.Status == "Abgeschlossen") badgeCls = "bg-success";
                else if (m.Status == "Abgesagt")      badgeCls = "bg-danger";
                else                                   badgeCls = "bg-primary";

                <div class="timeline-item" data-status="@m.Status">
                    <div class="timeline-marker">
                        <div class="timeline-dot"></div>
                        <div class="timeline-line"></div>
                    </div>
                    <div class="timeline-content">
                        <div class="timeline-date">
                            <i class="bi bi-calendar-event me-1"></i>@m.Datum.ToString("dd. MMMM yyyy")
                            <span class="badge @badgeCls ms-2">@m.Status</span>
                            @if (!string.IsNullOrEmpty(m.Klasse))
                            {
                                <span class="badge bg-secondary ms-1">@m.Klasse</span>
                            }
                            @if (!string.IsNullOrEmpty(m.Gruppe))
                            {
                                <span class="badge bg-light text-dark border ms-1">@m.Gruppe</span>
                            }
                        </div>
                        <div class="timeline-title">
                            <a asp-page="/Meetings/Detail" asp-route-id="@m.Id" asp-route-from="home"
                               class="text-decoration-none">@m.Thema</a>
                        </div>
                        @if (!string.IsNullOrEmpty(m.Leitung))
                        {
                            <div class="text-muted small"><i class="bi bi-person me-1"></i>@m.Leitung</div>
                        }
                        @if (!string.IsNullOrEmpty(m.Beschreibung))
                        {
                            <div class="text-muted small mt-1">
                                @(m.Beschreibung.Length > 120 ? m.Beschreibung[..120] + "…" : m.Beschreibung)
                            </div>
                        }
                        <div class="mt-2">
                            <a asp-page="/Meetings/Detail" asp-route-id="@m.Id" asp-route-from="home"
                               class="btn btn-sm btn-cms">
                                <i class="bi bi-eye me-1"></i>Öffnen
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (filterByGroup)
        {
            <div class="text-muted small mt-2">
                <i class="bi bi-filter me-1"></i>Gruppen: @string.Join(", ", allowedGruppen)
            </div>
        }
    </div>

    <script>
    (function () {
        function applyHmFilter() {
            var status = document.getElementById('hmFilterStatus').value;
            sessionStorage.setItem('mycms_hm_filter', status);
            document.querySelectorAll('#hmTimeline .timeline-item').forEach(function (item) {
                item.style.display = !status || item.dataset.status === status ? '' : 'none';
            });
        }
        var saved = sessionStorage.getItem('mycms_hm_filter');
        if (saved) { document.getElementById('hmFilterStatus').value = saved; applyHmFilter(); }
        document.getElementById('hmFilterStatus').addEventListener('change', applyHmFilter);
    })();
    </script>
}

@if (!string.IsNullOrWhiteSpace(site.FooterText))
{
    <div class="text-muted small mt-4 pt-3 border-top">@site.FooterText</div>
}
