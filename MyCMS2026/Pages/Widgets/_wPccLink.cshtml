@model MyCMS2026.Pages.Page.PageIndexModel
@inject MyCMS2026.Services.PccLinkService PccLinkSvc
@inject IConfiguration Config
@{
    if (!Config.GetValue<bool>("AlbatrosEnabled")) return;
    var link         = PccLinkSvc.BuildLink();
    var isConfigured = PccLinkSvc.IsConfigured;
    var userName     = User.Identity?.Name ?? "";
}

<div class="text-center py-5">
    <i class="bi bi-box-arrow-up-right" style="font-size: 3.5rem; color: var(--cms-blue);"></i>
    <h4 class="mt-3 mb-1">PCC Statistik-Dashboards</h4>
    <p class="text-muted mb-1">myalbatros.ch / Dashboards</p>

    @if (isConfigured)
    {
        <p class="text-muted small mb-4">
            <i class="bi bi-person-check me-1"></i>Du wirst als <strong>@userName</strong> automatisch angemeldet.
        </p>
    }
    else
    {
        <p class="small text-warning mb-4">
            <i class="bi bi-exclamation-triangle me-1"></i>SSO nicht konfiguriert – manuelle Anmeldung erforderlich.
        </p>
    }

    <a href="@link" target="_blank" rel="noopener noreferrer" class="btn btn-cms btn-lg px-4">
        <i class="bi bi-box-arrow-up-right me-2"></i>Dashboards öffnen
    </a>

    @if (isConfigured)
    {
        <p class="text-muted mt-4" style="font-size:.75rem;">
            <i class="bi bi-shield-lock me-1"></i>
            Signierter Link · gültig 2 Minuten · wird nach Anmeldung aus dem Browser-Verlauf entfernt.
        </p>
    }
</div>
