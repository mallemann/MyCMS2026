@model MyCMS2026.Pages.Page.PageIndexModel
@*
    Generischer Platzhalter für noch nicht implementierte Widgets.
    Wird automatisch angezeigt wenn kein passendes Widget-Partial gefunden wird.
*@
<div class="alert alert-secondary d-flex align-items-start gap-3 mt-2">
    <i class="bi bi-puzzle fs-3 text-secondary"></i>
    <div>
        <strong>Widget noch nicht implementiert</strong>
        <p class="mb-0 mt-1 text-muted">
            Das Widget <code>@Model.NavItem?.Widget</code> ist für diese Seite konfiguriert,
            wurde aber noch nicht implementiert.
        </p>
        @if (!string.IsNullOrEmpty(Model.NavItem?.ConfigString))
        {
            <p class="mb-0 mt-1 small text-muted">
                Config: <code>@Model.NavItem.ConfigString</code>
            </p>
        }
    </div>
</div>
