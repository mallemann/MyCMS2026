@model MyCMS2026.Pages.Page.PageIndexModel
@inject MyCMS2026.Services.KontextService KontextSvc
@inject MyCMS2026.Services.WeeklyMailService WeeklyMailSvc
@inject MyCMS2026.Services.UserService UserSvc
@{
    var userName  = User.Identity?.Name ?? "";
    var userRoles = User.Claims
        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
        .Select(c => c.Value)
        .ToList();

    // Cookie auslesen (serverseitig, damit JS-loses Rendering funktioniert)
    var menuLayout = Context.Request.Cookies["CmsMenuLayout"] ?? "vertical";
    var isHorizontal = menuLayout == "horizontal";

    // Kontexte des Users (nur solche, deren Gruppe ihm vom Admin zugeordnet ist = Baseline)
    var baselineGruppen = await WeeklyMailSvc.GetBaselineGruppenAsync(userName);
    var alleKontexte    = await KontextSvc.GetAllAsync();
    var meineKontexte   = alleKontexte
        .Where(k => baselineGruppen.Contains(k.Gruppe, StringComparer.OrdinalIgnoreCase))
        .ToList();
    var meUser      = await UserSvc.GetByNameAsync(userName);
    var deaktiviert = meUser?.DeaktivierteKontexte ?? new List<string>();
}

<div class="row g-4">

    @* ── Benutzer-Info ─────────────────────────────────────── *@
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header card-header-cms">
                <i class="bi bi-person-circle me-2"></i>Angemeldeter Benutzer
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Benutzername</span>
                    <span class="fw-semibold">@userName</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <span class="text-muted small">Rollen</span>
                    <div class="d-flex flex-wrap gap-1 justify-content-end">
                        @foreach (var role in userRoles)
                        {
                            <span class="badge bg-secondary">@role</span>
                        }
                        @if (!userRoles.Any())
                        {
                            <span class="text-muted small">Keine Rolle</span>
                        }
                    </div>
                </li>
            </ul>
        </div>
    </div>

    @* ── Menü-Layout ───────────────────────────────────────── *@
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header card-header-cms">
                <i class="bi bi-layout-sidebar me-2"></i>Menü-Layout
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Wähle, ob das Navigationsmenü links vertikal oder oben horizontal angezeigt wird.
                    Die Einstellung wird in diesem Browser gespeichert.
                </p>
                <div class="d-flex gap-3 flex-wrap">

                    <button type="button" id="btnMenuVertical"
                            class="btn @(!isHorizontal ? "btn-cms" : "btn-outline-secondary") d-flex flex-column align-items-center gap-2 px-4 py-3"
                            onclick="cmsSetMenuLayout('vertical')">
                        <i class="bi bi-layout-sidebar fs-3"></i>
                        <span class="small fw-semibold">Vertikal (links)</span>
                        @if (!isHorizontal)
                        {
                            <span class="badge bg-light text-dark border">Aktiv</span>
                        }
                    </button>

                    <button type="button" id="btnMenuHorizontal"
                            class="btn @(isHorizontal ? "btn-cms" : "btn-outline-secondary") d-flex flex-column align-items-center gap-2 px-4 py-3"
                            onclick="cmsSetMenuLayout('horizontal')">
                        <i class="bi bi-layout-three-columns fs-3"></i>
                        <span class="small fw-semibold">Horizontal (oben)</span>
                        @if (isHorizontal)
                        {
                            <span class="badge bg-light text-dark border">Aktiv</span>
                        }
                    </button>

                </div>
            </div>
        </div>
    </div>

    @* ── Kontexte ─────────────────────────────────────────── *@
    @if (meineKontexte.Any())
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header card-header-cms">
                    <i class="bi bi-diagram-3 me-2"></i>Kontexte
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Schalte einzelne Kontexte aus, um die zugehörige Gruppe temporär auszublenden
                        (Navigation, Suche, Timeline, Dashboard und Weekly Mail). Du kannst sie jederzeit wieder einschalten.
                    </p>
                    <form method="post" asp-page="/Account/Kontexte" asp-page-handler="Save">
                        <input type="hidden" name="returnPageId" value="@Model.Id" />
                        @for (int i = 0; i < meineKontexte.Count; i++)
                        {
                            var k = meineKontexte[i];
                            var isOn = !deaktiviert.Contains(k.Gruppe, StringComparer.OrdinalIgnoreCase);
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       name="aktiv" value="@k.Gruppe" id="ctx_@i" @(isOn ? "checked" : "") />
                                <label class="form-check-label" for="ctx_@i">
                                    <span class="fw-semibold">@k.Gruppe</span>
                                    @if (!string.IsNullOrEmpty(k.Beschreibung))
                                    {
                                        <span class="text-muted small">– @k.Beschreibung</span>
                                    }
                                </label>
                            </div>
                        }
                        <button type="submit" class="btn btn-cms btn-sm mt-2">
                            <i class="bi bi-floppy me-1"></i>Speichern
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }

</div>

<script>
function cmsSetMenuLayout(mode) {
    // Cookie mit 1 Jahr Gültigkeit setzen (Path = root damit er überall gilt)
    var expires = new Date();
    expires.setFullYear(expires.getFullYear() + 1);
    document.cookie = 'CmsMenuLayout=' + mode + '; path=/; expires=' + expires.toUTCString() + '; SameSite=Lax';
    location.reload();
}
</script>
