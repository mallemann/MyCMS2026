@model MyCMS2026.Pages.Page.PageIndexModel
@using MyCMS2026.Services
@using MyCMS2026.Models
@inject TodoService TodoSvc
@inject MyCMS2026.Services.KlassenService KlassenSvc
@inject WeeklyMailService WeeklyMailSvc
@{
    var isAdmin       = User.IsInRole("Administrator");
    var currentKuerzel = User.FindFirst("Kuerzel")?.Value ?? "";
    var gruppe        = Model.NavItem?.ConfigString ?? "";
    var pageId        = Model.Id;
    var todoKlassen = await KlassenSvc.GetKlassenAsync("todos");

    // Filter aus Query-String
    var search   = Context.Request.Query["search"].ToString();
    var status   = Context.Request.Query["status"].ToString();
    var klasse   = Context.Request.Query["klasse"].ToString();
    var meine    = Context.Request.Query["meine"].ToString() == "1";
    var userName = User.Identity?.Name ?? "";

    // Effektive Access-Gruppen des Users (Baseline minus deaktivierte Kontexte); ConfigString verengt zusätzlich
    var allowedGruppen = await WeeklyMailSvc.GetAllowedGruppenAsync(userName);
    bool CanSeeGr(string? g)
    {
        if (isAdmin) return string.IsNullOrWhiteSpace(gruppe) || string.Equals(g, gruppe, StringComparison.OrdinalIgnoreCase);
        if (!allowedGruppen.Any()) return false;
        if (!string.IsNullOrWhiteSpace(gruppe))
            return string.Equals(g, gruppe, StringComparison.OrdinalIgnoreCase) && allowedGruppen.Contains(g, StringComparer.OrdinalIgnoreCase);
        return !string.IsNullOrEmpty(g) && allowedGruppen.Contains(g, StringComparer.OrdinalIgnoreCase);
    }

    var all = await TodoSvc.GetAllAsync();
    all = all.Where(t => CanSeeGr(t.Gruppe)).ToList();
    if (!string.IsNullOrWhiteSpace(search))
        all = all.Where(t => t.Thema.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                              t.Verantwortlich.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
    if (status == "offen")    all = all.Where(t => !t.Erledigt).ToList();
    if (status == "erledigt") all = all.Where(t => t.Erledigt).ToList();
    if (!string.IsNullOrWhiteSpace(klasse)) all = all.Where(t => t.Klasse == klasse).ToList();
    if (meine)
        all = all.Where(t => (!string.IsNullOrEmpty(currentKuerzel) && t.Verantwortlich.Equals(currentKuerzel, StringComparison.OrdinalIgnoreCase))
                           || (!string.IsNullOrEmpty(userName)       && t.Verantwortlich.Equals(userName,       StringComparison.OrdinalIgnoreCase))).ToList();

    int offene  = all.Count(t => !t.Erledigt);
    int overdue = all.Count(t => !t.Erledigt && t.ErledigenBis < DateTime.Today);
}

@if (!isAdmin && !allowedGruppen.Any())
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Sie sind keiner Gruppe zugeordnet – bitte Administrator kontaktieren.</div>
    return;
}

@* Delete-Forms ausserhalb der Tabelle *@
@foreach (var t in all)
{
    <form id="wDelTodo-@t.Id" method="post" asp-page="/Todos/Index" asp-page-handler="Delete" style="display:none">
        <input type="hidden" name="id" value="@t.Id" />
        <input type="hidden" name="gruppe" value="@gruppe" />
    </form>
}

<div class="modal fade" id="wTodoConfirmDelete" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Task löschen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">Soll <strong id="wTodoDelName"></strong> wirklich gelöscht werden?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
                <button type="button" class="btn btn-danger" id="wTodoDelBtn"><i class="bi bi-trash me-1"></i>Löschen</button>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <div>
        <span class="badge badge-offen me-1">@offene offen</span>
        @if (overdue > 0) { <span class="badge badge-abgesagt">@overdue überfällig</span> }
    </div>
    @if (Model.HasExtendedAccess)
    {
        <a asp-page="/Todos/Edit" asp-route-gruppe="@gruppe" asp-route-returnPageId="@pageId" class="btn btn-cms btn-sm">
            <i class="bi bi-plus-circle me-1"></i>Neuer Task
        </a>
    }
</div>

<div class="cms-filter-bar mb-2">
    <form method="get" class="row g-2 align-items-end">
        <input type="hidden" name="Id" value="@pageId" />
        <div class="col-sm-4 col-md-3">
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Suchen..." />
        </div>
        <div class="col-sm-3 col-md-2">
            <select name="status" class="form-select form-select-sm">
                <option value="">Alle</option>
                <option value="offen"    selected="@(status == "offen"    ? "selected" : null)">Offen</option>
                <option value="erledigt" selected="@(status == "erledigt" ? "selected" : null)">Erledigt</option>
            </select>
        </div>
        <div class="col-sm-3 col-md-2">
            <select name="klasse" class="form-select form-select-sm">
                <option value="">Alle Klassen</option>
                @foreach (var k in todoKlassen)
                {
                    <option value="@k" selected="@(klasse == k ? "selected" : null)">@k</option>
                }
            </select>
        </div>
        <div class="col-auto d-flex align-items-center gap-2">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" name="meine" value="1" id="wTodoMeine"
                       @(meine ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label small text-nowrap" for="wTodoMeine">Meine</label>
            </div>
            <button type="submit" class="btn btn-cms btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
            <a asp-page="/Page/Index" asp-route-Id="@pageId" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-hover table-sm align-middle mb-0">
        <thead>
            <tr>
                <th>#</th><th>Thema</th><th>Verantwortlich</th><th>Bis</th><th>Status</th><th>Klasse / Gruppe</th><th class="text-end">Aktionen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in all)
            {
                var diff = (t.ErledigenBis - DateTime.Today).Days;
                string rowClass = t.Erledigt ? "table-success" : (diff < 0 ? "table-danger" : (diff <= 7 ? "table-warning" : ""));
                <tr class="@rowClass">
                    <td class="text-muted small">@t.TaskNr</td>
                    <td>
                        <span class="fw-semibold">@t.Thema</span>
                        @if (t.Files.Any())
                        {
                            <span class="badge bg-light text-muted border ms-1" title="@t.Files.Count Datei(en) angehängt">
                                <i class="bi bi-paperclip"></i> @t.Files.Count
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(t.ProjectName))
                        {
                            <a href="@Url.Page("/Projects/Detail", new { id = t.ProjectId })"
                               class="badge bg-light text-dark border ms-1 text-decoration-none">
                                <i class="bi bi-kanban me-1"></i>@t.ProjectName
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(t.Beschreibung))
                        {
                            <br /><small class="text-muted">@(t.Beschreibung.Length > 60 ? t.Beschreibung[..60] + "…" : t.Beschreibung)</small>
                        }
                    </td>
                    <td>@t.Verantwortlich</td>
                    <td class="text-nowrap">
                        @t.ErledigenBis.ToString("dd.MM.yy")
                        @if (!t.Erledigt && diff < 0)
                        {
                            <br /><small class="text-danger">@Math.Abs(diff)d überfällig</small>
                        }
                    </td>
                    <td>
                        @if (t.Erledigt) { <span class="badge badge-erledigt">Erledigt</span> }
                        else { <span class="badge badge-offen">Offen</span> }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(t.Klasse))
                        {
                            <span class="badge bg-light text-dark border me-1">@t.Klasse</span>
                        }
                        @if (!string.IsNullOrEmpty(t.Gruppe))
                        {
                            <span class="badge bg-secondary">@t.Gruppe</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-page="/Todos/Detail" asp-route-id="@t.Id" asp-route-returnPageId="@pageId" class="btn btn-sm btn-outline-primary" title="Öffnen">
                            <i class="bi bi-eye"></i>
                        </a>
                        @if (isAdmin || Model.HasExtendedAccess || (!string.IsNullOrEmpty(currentKuerzel) && t.Verantwortlich == currentKuerzel))
                        {
                            <form method="post" asp-page="/Todos/Index" asp-page-handler="Toggle" class="d-inline">
                                <input type="hidden" name="id" value="@t.Id" />
                                <input type="hidden" name="gruppe" value="@gruppe" />
                                <input type="hidden" name="returnPageId" value="@pageId" />
                                <button type="submit" class="btn btn-sm @(t.Erledigt ? "btn-outline-warning" : "btn-outline-success")"
                                        title="@(t.Erledigt ? "Als offen markieren" : "Als erledigt markieren")">
                                    <i class="bi bi-@(t.Erledigt ? "arrow-counterclockwise" : "check-circle")"></i>
                                </button>
                            </form>
                        }
                        @if (Model.HasExtendedAccess)
                        {
                            <a asp-page="/Todos/Edit" asp-route-id="@t.Id" asp-route-gruppe="@gruppe" asp-route-returnPageId="@pageId"
                               class="btn btn-sm btn-outline-secondary" title="Bearbeiten">
                                <i class="bi bi-pencil"></i>
                            </a>
                        }
                        @if (isAdmin)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" title="Löschen"
                                    onclick="wTodoConfirmDel('@t.Id','@t.Thema.Replace("'","\\'")')">
                                <i class="bi bi-trash"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
            @if (!all.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-3">Keine Tasks gefunden.</td></tr>
            }
        </tbody>
    </table>
</div>

<script>
let wTodoPendingId = null;
function wTodoConfirmDel(id, name) {
    wTodoPendingId = 'wDelTodo-' + id;
    document.getElementById('wTodoDelName').textContent = name;
    new bootstrap.Modal(document.getElementById('wTodoConfirmDelete')).show();
}
document.getElementById('wTodoDelBtn').addEventListener('click', function () {
    if (wTodoPendingId) document.getElementById(wTodoPendingId).submit();
});
</script>
